+// TestCacheBypassedKvGatedPrefixDecider_CacheUnderCapKvGateFires verifies that when
+// cachedTokens < cacheCapTokens, kvGate is evaluated normally.
+func TestCacheBypassedKvGatedPrefixDecider_CacheUnderCapKvGateFires(t *testing.T) {
+	const blockSize = 16
+	// cachedBlocks = 125 → cachedTokens = 2000; cacheCapTokens = 10000 → 2000 < 10000 → evaluate kvGate
