+// TestCacheBypassedKvGatedPrefixDecider_QueueDepthFires verifies that QD >= queueGate
+// triggers disaggregation even when cachedTokens >= cacheCapTokens (QD path independent of bypass).
+func TestCacheBypassedKvGatedPrefixDecider_QueueDepthFires(t *testing.T) {
+	const blockSize = 16
