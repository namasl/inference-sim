+		{"negative queueGate", 16, 16, -1, 0.05, 10000, "selected"},
+		{"negative kvGate", 16, 16, 1, -0.1, 10000, "selected"},
+		{"kvGate > 2.0", 16, 16, 1, 2.1, 10000, "selected"},
