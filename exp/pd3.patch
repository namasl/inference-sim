+				if r := recover(); r == nil {
+					t.Errorf("NewCacheBypassedKvGatedPrefixDecider(%d, %d, %d, %f, %d, %q): expected panic",
+						tc.threshold, tc.blockSize, tc.queueGate, tc.kvGate, tc.cacheCapTokens, tc.mode)
+				}
+			}()
+			NewCacheBypassedKvGatedPrefixDecider(tc.threshold, tc.blockSize, tc.queueGate, tc.kvGate, tc.cacheCapTokens, tc.mode, validCacheQuery)
+		})
+	}
+}
