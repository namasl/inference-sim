+	transientKvTokens := selectedSnap.KvTokensInUse - cachedTokens
+	if transientKvTokens < 0 {
+		transientKvTokens = 0
+	}
+	var transientKvUtil float64
+	if selectedSnap.TotalKvCapacityTokens > 0 {
+		transientKvUtil = float64(transientKvTokens) / float64(selectedSnap.TotalKvCapacityTokens)
+	}
+	// Cluster-aggregate raw KV utilization.
+	var clusterKvUtil float64
+	if clusterKvCap > 0 {
+		clusterKvUtil = float64(clusterKvTokens) / float64(clusterKvCap)
+	}
+	gateFires := (selectedSnap.QueueDepth >= d.queueGate) ||
+		(transientKvUtil >= d.kvGate) ||
+		(clusterKvUtil >= d.clusterKvGate)
+	return DisaggregationDecision{Disaggregate: gateFires}
+}
+
+// ClusterTransientKvGatedPrefixDecider extends ClusterKvGatedPrefixDecider by
+// subtracting each pod's per-request cache-hit contribution from the cluster
+// numerator before aggregating. This produces a topology-undiluted AND
+// cache-aware cluster signal: "what is the residual non-cache load across all
+// decode pods if I were routed to any of them?"
+//
+// Decide logic:
+//
+//	nonCachedTokens > threshold
+//	&& (selected.QueueDepth >= queueGate
+//	    || selected.transientKvUtil >= kvGate
+//	    || clusterTransientKvUtil >= clusterKvGate)
+//
+// where:
+//   - selected.transientKvUtil = max(0, KvTokensInUse - cachedBlocks(req)*blockSize) / cap
+//     (same as CacheAwareKvGatedPrefixDecider)
+//   - clusterTransientKvUtil = sum_p(max(0, p.KvTokensInUse - cacheQueryFn[p](req.InputTokens)*blockSize))
+//     / sum_p(p.TotalKvCapacityTokens)
+//
+// Degenerate cases:
+//   - clusterKvGate=2.0: clusterTransientKvUtil ∈ [0,1] never fires → byte-identical to
+//     CacheAwareKvGatedPrefixDecider (ablation).
+//   - clusterKvGate=0.0: cluster-clause always fires → degenerate to
+//     prefix-threshold (always disaggregate when threshold exceeded).
+//
+// mode must be "selected". pool-sum and max modes are excluded per RP-16/RP-19.
+// RP-13: cacheQuery is used as a per-pod LOAD discount, not a session-warmth proxy.
+type ClusterTransientKvGatedPrefixDecider struct {
+	threshold     int
+	blockSize     int
+	queueGate     int
+	kvGate        float64
+	clusterKvGate float64
+	cacheQuery    map[string]func([]int) int
+}
+
+// NewClusterTransientKvGatedPrefixDecider creates a ClusterTransientKvGatedPrefixDecider.
+// Invariants (R3 fail-loud): threshold >= 0, blockSize > 0, queueGate >= 0,
+// kvGate in [0, 2.0], clusterKvGate in [0, 2.0], mode == "selected".
+func NewClusterTransientKvGatedPrefixDecider(threshold, blockSize, queueGate int, kvGate, clusterKvGate float64, mode string, cacheQuery map[string]func([]int) int) *ClusterTransientKvGatedPrefixDecider {
+	if threshold < 0 {
+		panic(fmt.Sprintf("NewClusterTransientKvGatedPrefixDecider: threshold must be >= 0, got %d", threshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewClusterTransientKvGatedPrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	if queueGate < 0 {
+		panic(fmt.Sprintf("NewClusterTransientKvGatedPrefixDecider: queueGate must be >= 0, got %d", queueGate))
+	}
+	if kvGate < 0 || kvGate > 2.0 {
+		panic(fmt.Sprintf("NewClusterTransientKvGatedPrefixDecider: kvGate must be in [0, 2.0], got %f", kvGate))
+	}
+	if clusterKvGate < 0 || clusterKvGate > 2.0 {
+		panic(fmt.Sprintf("NewClusterTransientKvGatedPrefixDecider: clusterKvGate must be in [0, 2.0], got %f", clusterKvGate))
+	}
+	if mode != "selected" {
+		panic(fmt.Sprintf("NewClusterTransientKvGatedPrefixDecider: mode must be \"selected\", got %q (pool-sum and max aggregation modes are not supported; see RP-16/RP-19)", mode))
+	}
+	return &ClusterTransientKvGatedPrefixDecider{
+		threshold:     threshold,
+		blockSize:     blockSize,
+		queueGate:     queueGate,
+		kvGate:        kvGate,
+		clusterKvGate: clusterKvGate,
+		cacheQuery:    cacheQuery,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens > threshold AND
+// (selected.QueueDepth >= queueGate OR selected.transientKvUtil >= kvGate
+// OR clusterTransientKvUtil >= clusterKvGate).
+//
+// clusterTransientKvUtil subtracts each pod's per-request cache-hit contribution
+// from its KvTokensInUse before summing, producing a cache-aware cluster signal.
+//
+// Early returns (all yielding Disaggregate=false):
+//   - len(req.InputTokens) == 0
+//   - state == nil
+//   - state.SelectedInstance == "" (no upstream selection)
+//   - cacheQuery is nil, or the selected instance is missing from the map,
+//     or its closure is nil
+//   - no snapshot in state.Snapshots matches state.SelectedInstance
+func (d *ClusterTransientKvGatedPrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	if nonCachedTokens <= d.threshold {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Find the selected snapshot and compute cache-subtracted cluster-aggregate transient KV.
+	var selectedSnap *RoutingSnapshot
+	var clusterTransientKvTokens, clusterKvCap int64
+	for i := range state.Snapshots {
+		snap := &state.Snapshots[i]
+		// Query each pod's cache for this request's tokens (RP-13: load discount, not warmth proxy).
+		var podCachedTokens int64
+		if podFn, exists := d.cacheQuery[snap.ID]; exists && podFn != nil {
+			podCachedBlocks := podFn(req.InputTokens)
+			podCachedTokens = int64(podCachedBlocks * d.blockSize)
+		}
+		podTransient := snap.KvTokensInUse - podCachedTokens
+		if podTransient < 0 {
+			podTransient = 0
+		}
+		clusterTransientKvTokens += podTransient
+		clusterKvCap += snap.TotalKvCapacityTokens
+		if snap.ID == state.SelectedInstance {
+			selectedSnap = snap
+		}
+	}
+	if selectedSnap == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Per-pod cache-subtracted transient KV for selected pod (same as CacheAwareKvGatedPrefixDecider).
+	cachedTokens := int64(cachedBlocks * d.blockSize)
+	transientKvTokens := selectedSnap.KvTokensInUse - cachedTokens
+	if transientKvTokens < 0 {
+		transientKvTokens = 0
+	}
+	var transientKvUtil float64
+	if selectedSnap.TotalKvCapacityTokens > 0 {
+		transientKvUtil = float64(transientKvTokens) / float64(selectedSnap.TotalKvCapacityTokens)
+	}
+	// Cluster-aggregate transient KV utilization (cache-subtracted across all pods).
+	var clusterTransientKvUtil float64
+	if clusterKvCap > 0 {
+		clusterTransientKvUtil = float64(clusterTransientKvTokens) / float64(clusterKvCap)
+	}
+	gateFires := (selectedSnap.QueueDepth >= d.queueGate) ||
+		(transientKvUtil >= d.kvGate) ||
+		(clusterTransientKvUtil >= d.clusterKvGate)
+	return DisaggregationDecision{Disaggregate: gateFires}
+}
