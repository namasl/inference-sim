+// TestCacheBypassedKvGatedPrefixDecider_CacheBypassesAboveCap is the KEY new behavior:
+// when cachedTokens >= cacheCapTokens and QD=0, kvGate is bypassed → colocate.
+func TestCacheBypassedKvGatedPrefixDecider_CacheBypassesAboveCap(t *testing.T) {
+	const blockSize = 16
+	// cachedBlocks = 1250 → cachedTokens = 20000; cacheCapTokens = 10000 → 20000 >= 10000 → bypass kvGate
+	// QD=0, transientKvUtil=0.50 >> kvGate=0.05 → but kvGate is bypassed → colocate
+	cachedBlocks := 1250
+	cacheQuery := map[string]func([]int) int{
+		"decode_0": func([]int) int { return cachedBlocks },
+	}
+	decider := NewCacheBypassedKvGatedPrefixDecider(16, blockSize, 1, 0.05, 10000, "selected", cacheQuery)
+	// 21000 input tokens total, 20000 cached → nonCached=1000 > threshold=16
+	req := &Request{ID: "req-1", InputTokens: make([]int, 21000)}
+	kvInUse := int64(cachedBlocks*blockSize) + 50000 // 50000 transient tokens → util=0.50
+	state := &RouterState{
+		Snapshots: []RoutingSnapshot{{
+			ID:                    "decode_0",
+			QueueDepth:            0,
+			KvTokensInUse:         kvInUse,
+			TotalKvCapacityTokens: 100000,
+		}},
+		SelectedInstance: "decode_0",
+	}
+	got := decider.Decide(req, state)
+	if got.Disaggregate {
+		t.Errorf("expected Disaggregate=false (kvGate bypassed because cachedTokens >= cap), got true")
+	}
+}
