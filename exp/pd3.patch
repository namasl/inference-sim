+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: queueGate must be >= 0, got %d", queueGate))
+	}
+	if kvGate < 0 {
+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: kvGate must be >= 0, got %f", kvGate))
+	}
+	if kvGate > 2.0 {
+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: kvGate must be <= 2.0, got %f", kvGate))
+	}
+	if cacheCapTokens < 0 {
+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: cacheCapTokens must be >= 0, got %d", cacheCapTokens))
+	}
+	if mode != "selected" {
+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: mode must be \"selected\", got %q (pool-sum and max aggregation modes are not supported; see RP-16/RP-19)", mode))
