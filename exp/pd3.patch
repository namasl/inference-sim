+	var transientKvUtil float64
+	if selectedSnap.TotalKvCapacityTokens > 0 {
+		transientKvUtil = float64(transientKvTokens) / float64(selectedSnap.TotalKvCapacityTokens)
+	}
+	gateFires := (selectedSnap.QueueDepth >= d.queueGate) || (transientKvUtil >= d.kvGate)
+	return DisaggregationDecision{Disaggregate: gateFires}
+}
+
+// compile-time interface compliance check
+var _ DisaggregationDecider = (*LongPrefillAwarePrefixDecider)(nil)
+
+// ---------------------------------------------------------------------------
+// KvAdmissionGatedPrefixDecider (iter-36)
+// ---------------------------------------------------------------------------
+
+// KvAdmissionGatedPrefixDecider extends CacheAwareKvGatedPrefixDecider with a
+// predictive KV-admission gate: the decider ORs a third clause alongside the
+// existing QueueDepth and transient-KV gates.
+//
+// Gate logic (when nonCachedTokens > threshold):
+//
+//	cachedBlocks    = cacheQuery(req.InputTokens)
+//	nonCachedTokens = len(req.InputTokens) − cachedBlocks × blockSize
+//	qdFires         = (selected.QueueDepth >= queueGate)
+//	transientKv     = max(0, KvTokensInUse − cachedBlocks×blockSize)
+//	kvFires         = (transientKv / TotalKvCapacityTokens >= kvGate)
+//	admitFires      = (KvTokensInUse + nonCachedTokens) / TotalKvCapacityTokens >= admitThreshold
+//	Disaggregate    = qdFires || kvFires || admitFires
+//
+// admitThreshold=2.0 makes admitFires unsatisfiable (predicted util ≤ ~1.05 in
+// any realistic state), degenerating the decider to CacheAwareKvGatedPrefixDecider
+// byte-for-byte (used in h-ablation arm A3).
+//
+// The admit clause uses raw KvTokensInUse (not cache-subtracted) because cached
+// blocks DO occupy admit headroom even when they do not contribute to active
+// decode load (intentional asymmetry with the transient-KV clause).
+//
+// mode must be "selected". pool-sum and max modes are excluded per RP-16/RP-19.
+type KvAdmissionGatedPrefixDecider struct {
+	threshold      int
+	blockSize      int
+	queueGate      int
+	kvGate         float64
+	admitThreshold float64
+	cacheQuery     map[string]func([]int) int
+}
+
+// NewKvAdmissionGatedPrefixDecider creates a KvAdmissionGatedPrefixDecider.
+// Invariants (R3 fail-loud): threshold >= 0, blockSize > 0, queueGate >= 0,
+// kvGate in [0, 2.0], admitThreshold in [0, 2.0], mode == "selected".
+func NewKvAdmissionGatedPrefixDecider(threshold, blockSize, queueGate int, kvGate float64, admitThreshold float64, mode string, cacheQuery map[string]func([]int) int) *KvAdmissionGatedPrefixDecider {
+	if mode != "selected" {
+		panic(fmt.Sprintf("NewKvAdmissionGatedPrefixDecider: mode must be \"selected\", got %q (pool-sum and max aggregation modes are not supported; see RP-16/RP-19)", mode))
+	}
+	if threshold < 0 {
+		panic(fmt.Sprintf("NewKvAdmissionGatedPrefixDecider: threshold must be >= 0, got %d", threshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewKvAdmissionGatedPrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	if queueGate < 0 {
+		panic(fmt.Sprintf("NewKvAdmissionGatedPrefixDecider: queueGate must be >= 0, got %d", queueGate))
+	}
+	if kvGate < 0 {
+		panic(fmt.Sprintf("NewKvAdmissionGatedPrefixDecider: kvGate must be >= 0, got %f", kvGate))
+	}
+	if kvGate > 2.0 {
+		panic(fmt.Sprintf("NewKvAdmissionGatedPrefixDecider: kvGate must be <= 2.0, got %f", kvGate))
+	}
+	if admitThreshold < 0 {
+		panic(fmt.Sprintf("NewKvAdmissionGatedPrefixDecider: admitThreshold must be >= 0, got %f", admitThreshold))
+	}
+	if admitThreshold > 2.0 {
+		panic(fmt.Sprintf("NewKvAdmissionGatedPrefixDecider: admitThreshold must be <= 2.0, got %f", admitThreshold))
+	}
+	return &KvAdmissionGatedPrefixDecider{
+		threshold:      threshold,
+		blockSize:      blockSize,
+		queueGate:      queueGate,
+		kvGate:         kvGate,
+		admitThreshold: admitThreshold,
+		cacheQuery:     cacheQuery,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens > threshold AND
+// (QueueDepth >= queueGate OR transientKvUtil >= kvGate OR predictedUtil >= admitThreshold).
+// When admitThreshold=2.0, the admit clause is unsatisfiable and the decider is
+// byte-identical to CacheAwareKvGatedPrefixDecider.
+func (d *KvAdmissionGatedPrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	if nonCachedTokens <= d.threshold {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Find the selected snapshot by ID (read-only linear scan).
+	var selectedSnap *RoutingSnapshot
+	for i := range state.Snapshots {
+		if state.Snapshots[i].ID == state.SelectedInstance {
+			selectedSnap = &state.Snapshots[i]
+			break
+		}
+	}
+	if selectedSnap == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Clause 1: QueueDepth gate (same as CacheAwareKvGatedPrefixDecider).
+	qdFires := selectedSnap.QueueDepth >= d.queueGate
+	// Clause 2: transient KV utilization gate (cache-subtracted, same as CacheAwareKvGatedPrefixDecider).
+	cachedTokens := int64(cachedBlocks * d.blockSize)
+	transientKvTokens := selectedSnap.KvTokensInUse - cachedTokens
+	if transientKvTokens < 0 {
+		transientKvTokens = 0
+	}
+	var transientKvUtil float64
+	if selectedSnap.TotalKvCapacityTokens > 0 {
+		transientKvUtil = float64(transientKvTokens) / float64(selectedSnap.TotalKvCapacityTokens)
+	}
+	kvFires := transientKvUtil >= d.kvGate
+	// Clause 3: predictive admission gate (raw KvTokensInUse, not cache-subtracted).
+	// Uses raw occupancy because cached blocks DO occupy admit headroom.
+	var admitFires bool
+	if selectedSnap.TotalKvCapacityTokens > 0 {
+		predictedUtil := float64(selectedSnap.KvTokensInUse+int64(nonCachedTokens)) / float64(selectedSnap.TotalKvCapacityTokens)
+		admitFires = predictedUtil >= d.admitThreshold
+	}
+	return DisaggregationDecision{Disaggregate: qdFires || kvFires || admitFires}
+}
+
+// compile-time interface compliance check
+var _ DisaggregationDecider = (*KvAdmissionGatedPrefixDecider)(nil)
+
+// ---------------------------------------------------------------------------
+// AdmissionAndLongPrefillAwarePrefixDecider (iter-38)
+// ---------------------------------------------------------------------------
+
+// AdmissionAndLongPrefillAwarePrefixDecider combines the long-prefill
+// force-disagg branch from LongPrefillAwarePrefixDecider with the predictive
+// KV-admission gate from KvAdmissionGatedPrefixDecider into a single Decide()
+// invocation.
+//
+// Decide() logic (in order):
+//  1. Trivial guards: empty InputTokens / nil state / "" SelectedInstance /
+//     nil cacheQuery → Colocate.
+//  2. cachedBlocks = cacheQuery[selected](req.InputTokens);
+//     nonCachedTokens = len(InputTokens) - cachedBlocks*blockSize.
+//  3. If nonCachedTokens > longPrefillThreshold → Disaggregate (force-disagg
+//     branch, fires before threshold short-circuit per LongPrefillAware order).
+//  4. If nonCachedTokens <= threshold → Colocate (short-circuit).
+//  5. Locate selectedSnap; nil → Colocate.
+//  6. qdFires = (QueueDepth >= queueGate).
+//     transientKvTokens = max(0, KvTokensInUse - cachedBlocks*blockSize).
+//     kvFires = (transientKvTokens / TotalKvCapacityTokens >= kvGate).
+//     admitFires = predictedUtil >= admitThreshold AND
+//                  (admitCeiling == 0 OR predictedUtil < admitCeiling),
+//     where predictedUtil = (KvTokensInUse + nonCachedTokens) / cap
+//     (raw KvTokensInUse, not cache-subtracted — intentional per RP-90).
+//     admitCeiling == 0 means vacuous (no ceiling; identical to prior behavior).
+//     admitCeiling > 0 means banded: admit fires only when
+//     admitThreshold <= predictedUtil < admitCeiling (iter-45).
+//     Disaggregate iff (qdFires || kvFires || admitFires).
+//
+// mode must be "selected". pool-sum and max modes are excluded per RP-16/RP-19.
+type AdmissionAndLongPrefillAwarePrefixDecider struct {
+	threshold            int
+	blockSize            int
+	queueGate            int
+	kvGate               float64
+	kvCeiling            float64
+	admitThreshold       float64
+	admitCeiling         float64
+	longPrefillThreshold int
+	admitMinTokens       int
+	kvMinTokens          int
+	qdCircuitBreaker     int
+	qdLowCircuitBreaker  int
+	ifrGate              int
+	ifrCeiling           int
+	ifrMinTokens         int
+	roundIndexCap        int
+	cacheQuery           map[string]func([]int) int
+}
+
+// NewAdmissionAndLongPrefillAwarePrefixDecider creates an
+// AdmissionAndLongPrefillAwarePrefixDecider.
+// Invariants (R3 fail-loud): threshold >= 0, blockSize > 0, queueGate >= 0,
+// kvGate in [0, 2.0], admitThreshold in [0, 2.0], longPrefillThreshold >= 0,
+// admitMinTokens >= 0, kvMinTokens >= 0, admitCeiling >= 0 and <= 2.0, and
+// when admitCeiling > 0 it must exceed admitThreshold (otherwise the band
+// collapses to empty), kvCeiling >= 0 and <= 2.0, and when kvCeiling > 0 it
+// must exceed kvGate (otherwise the band collapses to empty), mode == "selected".
+// kvMinTokens gates the kvFires clause: kvFires fires only when
+// nonCachedTokens >= kvMinTokens. Default 0 (vacuous — kvFires fires on all
+// eligible requests).
+// kvCeiling bands the kvFires clause to [kvGate, kvCeiling): kvFires fires
+// only when kvGate <= transientKvUtil < kvCeiling. 0 means vacuous (no ceiling,
+// identical to iter-48 A2 behavior).
+// ifrCeiling bands the ifrFires clause to [ifrGate, ifrCeiling): ifrFires fires
+// only when ifrGate <= InFlightRequests < ifrCeiling. 0 means vacuous (no ceiling,
+// byte-identical to iter-55 A3 behavior). When > 0, must exceed ifrGate.
+// ifrMinTokens gates the ifrFires clause: ifrFires fires only when
+// nonCachedTokens >= ifrMinTokens AND the rest of the IFR clause conditions hold.
+// Default 0 (vacuous — ifrFires fires on all eligible requests; byte-identical to iter-56 behavior).
+func NewAdmissionAndLongPrefillAwarePrefixDecider(threshold, blockSize, queueGate int, kvGate float64, admitThreshold float64, longPrefillThreshold, admitMinTokens, kvMinTokens, qdCircuitBreaker, qdLowCircuitBreaker, ifrGate, ifrCeiling, ifrMinTokens int, kvCeiling float64, admitCeiling float64, mode string, cacheQuery map[string]func([]int) int, roundIndexCap int) *AdmissionAndLongPrefillAwarePrefixDecider {
+	if mode != "selected" {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: mode must be \"selected\", got %q (pool-sum and max aggregation modes are not supported; see RP-16/RP-19)", mode))
+	}
+	if threshold < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: threshold must be >= 0, got %d", threshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	if queueGate < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: queueGate must be >= 0, got %d", queueGate))
+	}
+	if kvGate < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: kvGate must be >= 0, got %f", kvGate))
+	}
+	if kvGate > 2.0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: kvGate must be <= 2.0, got %f", kvGate))
+	}
+	if admitThreshold < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: admitThreshold must be >= 0, got %f", admitThreshold))
+	}
+	if admitThreshold > 2.0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: admitThreshold must be <= 2.0, got %f", admitThreshold))
+	}
+	if longPrefillThreshold < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: longPrefillThreshold must be >= 0, got %d", longPrefillThreshold))
+	}
+	if admitMinTokens < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: admitMinTokens must be >= 0, got %d", admitMinTokens))
+	}
+	if kvMinTokens < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: kvMinTokens must be >= 0, got %d", kvMinTokens))
+	}
+	if qdCircuitBreaker < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: qdCircuitBreaker must be >= 0, got %d", qdCircuitBreaker))
+	}
+	if qdLowCircuitBreaker < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: qdLowCircuitBreaker must be >= 0, got %d", qdLowCircuitBreaker))
+	}
+	if ifrGate < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: ifrGate must be >= 0, got %d", ifrGate))
+	}
+	if ifrCeiling < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: ifrCeiling must be >= 0, got %d", ifrCeiling))
+	}
+	if ifrCeiling > 0 && ifrCeiling <= ifrGate {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: ifrCeiling (%d) must exceed ifrGate (%d) when non-zero; a ceiling at or below the gate collapses the ifrFires band to empty (use ifrCeiling=0 to disable the ceiling, or set ifrCeiling > ifrGate)", ifrCeiling, ifrGate))
+	}
+	if ifrMinTokens < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: ifrMinTokens must be >= 0, got %d", ifrMinTokens))
+	}
+	if kvCeiling < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: kvCeiling must be >= 0, got %f", kvCeiling))
+	}
+	if kvCeiling > 2.0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: kvCeiling must be <= 2.0, got %f", kvCeiling))
+	}
+	if kvCeiling > 0 && kvCeiling <= kvGate {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: kvCeiling (%f) must exceed kvGate (%f) when non-zero; a ceiling at or below the gate collapses the kvFires band to empty (use kvCeiling=0 to disable the ceiling, or set kvCeiling > kvGate)", kvCeiling, kvGate))
+	}
+	if admitCeiling < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: admitCeiling must be >= 0, got %f", admitCeiling))
+	}
+	if admitCeiling > 2.0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: admitCeiling must be <= 2.0, got %f", admitCeiling))
+	}
+	if admitCeiling > 0 && admitCeiling <= admitThreshold {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: admitCeiling (%f) must exceed admitThreshold (%f) when non-zero; a ceiling at or below the threshold collapses the admit band to empty (iter-45 design intent: use admitCeiling=0 to disable the ceiling, or set admitCeiling > admitThreshold)", admitCeiling, admitThreshold))
+	}
+	if roundIndexCap < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: roundIndexCap must be >= 0, got %d", roundIndexCap))
+	}
+	return &AdmissionAndLongPrefillAwarePrefixDecider{
+		threshold:            threshold,
+		blockSize:            blockSize,
+		queueGate:            queueGate,
+		kvGate:               kvGate,
+		kvCeiling:            kvCeiling,
+		admitThreshold:       admitThreshold,
+		admitCeiling:         admitCeiling,
+		longPrefillThreshold: longPrefillThreshold,
+		admitMinTokens:       admitMinTokens,
+		kvMinTokens:          kvMinTokens,
+		qdCircuitBreaker:     qdCircuitBreaker,
+		qdLowCircuitBreaker:  qdLowCircuitBreaker,
+		ifrGate:              ifrGate,
+		ifrCeiling:           ifrCeiling,
+		ifrMinTokens:         ifrMinTokens,
+		roundIndexCap:        roundIndexCap,
+		cacheQuery:           cacheQuery,
+	}
+}
+
+// Decide returns Disaggregate=true when:
+//   - nonCachedTokens > longPrefillThreshold (force-disagg, unconditional — NOT subject to either
+//     circuit breaker or the ifrFires clause; long-prefill protection is always active per RP-35/RP-63), OR
+//   - nonCachedTokens > threshold AND
+//     (QueueDepth >= queueGate OR transientKvUtil >= kvGate OR predictedUtil >= admitThreshold
+//      OR (ifrGate > 0 AND selectedSnap.InFlightRequests >= ifrGate))
+//     AND (qdCircuitBreaker == 0 OR selectedSnap.QueueDepth < qdCircuitBreaker)
+//     AND (qdLowCircuitBreaker == 0 OR selectedSnap.QueueDepth >= qdLowCircuitBreaker).
+//
+// ifrFires = (ifrMinTokens == 0 OR nonCachedTokens >= ifrMinTokens) AND ifrGate > 0 AND
+// selectedSnap.InFlightRequests >= ifrGate AND (ifrCeiling == 0 OR
+// selectedSnap.InFlightRequests < ifrCeiling)) is the fourth OR-clause (iter-52/iter-56/iter-57):
+// fires when the selected decode pod InFlightRequests is in [ifrGate, ifrCeiling) AND
+// nonCachedTokens >= ifrMinTokens. ifrGate == 0 short-circuits to false (vacuous; byte-identical
+// to iter-48 A2). ifrCeiling == 0 means no ceiling (vacuous; byte-identical to iter-55 A3).
+// ifrMinTokens == 0 means vacuous token-min (byte-identical to iter-56 A3). ifrMinTokens gates
+// the clause: when > 0, ifrFires fires only if nonCachedTokens >= ifrMinTokens, decoupling
+// cold round-0 (large nonCached) from warm follow-up rounds (small nonCached).
+// qdCircuitBreaker overrides the OR-combinator output to false when the selected decode pod
+// QueueDepth >= qdCircuitBreaker (iter-50, suppress at HIGH QD). The long-prefill force-disagg
+// branch executes before either breaker check and is exempted unconditionally.
+// qdLowCircuitBreaker overrides the OR-combinator output to false when the selected decode pod
+// QueueDepth < qdLowCircuitBreaker (iter-51, suppress at LOW QD; inverse direction). The two
+// breakers fire on disjoint QD bands and are order-independent.
+func (d *AdmissionAndLongPrefillAwarePrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	// Force-disaggregate branch: long prefills bypass per-pod gate (order preserved
+	// from LongPrefillAwarePrefixDecider — must precede threshold short-circuit).
+	if nonCachedTokens > d.longPrefillThreshold {
+		return DisaggregationDecision{Disaggregate: true}
+	}
+	if nonCachedTokens <= d.threshold {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Find the selected snapshot by ID (read-only linear scan).
+	var selectedSnap *RoutingSnapshot
+	for i := range state.Snapshots {
+		if state.Snapshots[i].ID == state.SelectedInstance {
+			selectedSnap = &state.Snapshots[i]
+			break
+		}
+	}
+	if selectedSnap == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Clause 1: QueueDepth gate.
+	qdFires := selectedSnap.QueueDepth >= d.queueGate
+	// Clause 2: transient KV utilization gate (cache-subtracted).
+	cachedTokens := int64(cachedBlocks * d.blockSize)
+	transientKvTokens := selectedSnap.KvTokensInUse - cachedTokens
+	if transientKvTokens < 0 {
+		transientKvTokens = 0
+	}
+	var transientKvUtil float64
+	if selectedSnap.TotalKvCapacityTokens > 0 {
+		transientKvUtil = float64(transientKvTokens) / float64(selectedSnap.TotalKvCapacityTokens)
+	}
+	// kvMinTokens gate: when > 0, kvFires fires only if nonCachedTokens >= kvMinTokens,
+	// decoupling cold round-0 (large nonCached) from warm follow-up rounds (small nonCached).
+	// kvMinTokens == 0 short-circuits to true (vacuous, byte-identical to prior iterations).
+	kvFires := (d.kvMinTokens == 0 || nonCachedTokens >= d.kvMinTokens) && transientKvUtil >= d.kvGate && (d.kvCeiling == 0 || transientKvUtil < d.kvCeiling)
+	// Clause 3: predictive admission gate (raw KvTokensInUse, not cache-subtracted).
+	// Cached blocks DO occupy admit headroom (intentional asymmetry with transient-KV clause).
+	// admitMinTokens gate: when > 0, admit fires only if nonCachedTokens >= admitMinTokens,
+	// decoupling cold round-0 (large nonCached) from warm follow-up rounds (small nonCached).
+	// admitCeiling gate (iter-45): when > 0, admit fires only when predictedUtil < admitCeiling,
+	// banding the admit clause to [admitThreshold, admitCeiling). admitCeiling == 0 is vacuous.
+	var admitFires bool
+	if selectedSnap.TotalKvCapacityTokens > 0 && (d.admitMinTokens == 0 || nonCachedTokens >= d.admitMinTokens) {
+		predictedUtil := float64(selectedSnap.KvTokensInUse+int64(nonCachedTokens)) / float64(selectedSnap.TotalKvCapacityTokens)
+		admitFires = predictedUtil >= d.admitThreshold &&
+			(d.admitCeiling == 0 || predictedUtil < d.admitCeiling)
+	}
+	// Clause 4: per-pod selected-decode InFlightRequests gate (iter-52/iter-56/iter-57).
+	// ifrGate == 0 short-circuits to false (vacuous; byte-identical to iter-48 A2 / iter-51 A3).
+	// ifrCeiling == 0 means vacuous ceiling (byte-identical to iter-55 A3 when ceiling not set).
+	// ifrMinTokens gate: when > 0, ifrFires fires only if nonCachedTokens >= ifrMinTokens,
+	// decoupling cold round-0 (large nonCached) from warm follow-up rounds (small nonCached).
+	// ifrMinTokens == 0 short-circuits to true (vacuous, byte-identical to iter-56 A3).
+	ifrFires := (d.ifrMinTokens == 0 || nonCachedTokens >= d.ifrMinTokens) && d.ifrGate > 0 && selectedSnap.InFlightRequests >= d.ifrGate && (d.ifrCeiling == 0 || selectedSnap.InFlightRequests < d.ifrCeiling)
+	decision := qdFires || kvFires || admitFires || ifrFires
+	if d.qdCircuitBreaker > 0 && selectedSnap.QueueDepth >= d.qdCircuitBreaker {
+		decision = false
+	}
+	if d.qdLowCircuitBreaker > 0 && selectedSnap.QueueDepth < d.qdLowCircuitBreaker {
+		decision = false
+	}
+	// roundIndexCap override (iter-59, RP-13/RP-45): when cap > 0 and the request is at
+	// a warm round (RoundIndex >= cap), suppress the OR-combinator decision. The long-prefill
+	// force-disagg early return above always runs before this point (RP-35/RP-63 preserved).
+	// cap == 0 is vacuous: this branch never executes, preserving byte-identity with iter-58.
+	if d.roundIndexCap > 0 && req.RoundIndex >= d.roundIndexCap {
+		decision = false
+	}
+	return DisaggregationDecision{Disaggregate: decision}
+}
+
+// compile-time interface compliance check
+var _ DisaggregationDecider = (*AdmissionAndLongPrefillAwarePrefixDecider)(nil)
+
