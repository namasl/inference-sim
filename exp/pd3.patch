+// TestCacheBypassedKvGatedPrefixDecider_CacheCapZeroEqualsLoadGated verifies byte-equivalence
+// to LoadGatedPrefix (QD-only) at the per-Decide level when cacheCapTokens=0.
+func TestCacheBypassedKvGatedPrefixDecider_CacheCapZeroEqualsLoadGated(t *testing.T) {
+	const threshold = 16
+	const blockSize = 16
+	cacheQuery := map[string]func([]int) int{
+		"decode_0": func([]int) int { return 0 },
+	}
+	// cacheCap=0 → cachedTokens=0 is NOT < 0 → kvGate always bypassed → pure QD gate
+	bypassedDecider := NewCacheBypassedKvGatedPrefixDecider(threshold, blockSize, 1, 0.05, 0, "selected", cacheQuery)
+	// LoadGatedPrefix with kvGate=2.0 is QD-only (kvGate>1.0 never fires)
+	loadGatedDecider := NewCacheAwareKvGatedPrefixDecider(threshold, blockSize, 1, 2.0, "selected", cacheQuery)
+
+	req := &Request{ID: "req-1", InputTokens: make([]int, 100)}
+
+	testCases := []struct {
+		qd       int
+		wantDisagg bool
+	}{
+		{0, false}, // QD=0 < gate=1 → colocate
+		{1, true},  // QD=1 >= gate=1 → disaggregate
+		{5, true},  // QD=5 >= gate=1 → disaggregate
+	}
+	for _, tc := range testCases {
+		state := &RouterState{
+			Snapshots: []RoutingSnapshot{{
+				ID:                    "decode_0",
+				QueueDepth:            tc.qd,
+				KvTokensInUse:         50000, // high KV, but kvGate is bypassed/vacuous
+				TotalKvCapacityTokens: 100000,
+			}},
+			SelectedInstance: "decode_0",
+		}
+		got1 := bypassedDecider.Decide(req, state)
+		got2 := loadGatedDecider.Decide(req, state)
+		if got1 != got2 {
+			t.Errorf("QD=%d: bypassed(%v) != loadGated(%v); cap=0 must degenerate to QD-only",
+				tc.qd, got1.Disaggregate, got2.Disaggregate)
+		}
+	}
+}
