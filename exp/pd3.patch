+// TestNewCacheBypassedKvGatedPrefixDecider_Panics verifies R3 constructor validation.
+func TestNewCacheBypassedKvGatedPrefixDecider_Panics(t *testing.T) {
+	validCacheQuery := map[string]func([]int) int{"decode_0": func([]int) int { return 0 }}
+	tests := []struct {
+		name           string
+		threshold      int
+		blockSize      int
+		queueGate      int
+		kvGate         float64
+		cacheCapTokens int
+		mode           string
+	}{
