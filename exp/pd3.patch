+	req := &Request{ID: "req-1", InputTokens: make([]int, 3000)}
+	kvInUse := int64(cachedBlocks*blockSize) + 10000 // 10000 transient → util=0.10
+	state := &RouterState{
+		Snapshots: []RoutingSnapshot{{
+			ID:                    "decode_0",
+			QueueDepth:            0,
+			KvTokensInUse:         kvInUse,
+			TotalKvCapacityTokens: 100000,
