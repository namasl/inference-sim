+// ContentBurstLatchAdaptivePrefixDecider extends ContentLatchAdaptivePrefixDecider
+// by replacing the single-event fire condition with a sliding-window burst count:
+// append the timestamp of each code-class arrival (nonCachedTokens >= contentThreshold)
+// to a ring buffer; refresh lastFireUs only when at least burstThreshold timestamps
+// fall within the last burstWindowUs. The latch is active while
+// Clock − lastFireUs < latchDurationUs and selects highThreshold; otherwise lowThreshold.
+//
+// This discriminates bursty (weibull cv=2.0) from steady (poisson) code arrivals:
+// weibull bursts can deliver burstThreshold+ arrivals in burstWindowUs whereas
+// steady poisson does so with negligible probability. Does NOT read PrefillSnapshots
+// (synchronous, INV-9-safe). Ring-buffer mutation is per-request deterministic (INV-6).
+type ContentBurstLatchAdaptivePrefixDecider struct {
+	contentThreshold int
+	burstWindowUs    int64
+	burstThreshold   int
+	latchDurationUs  int64
+	lowThreshold     int
+	highThreshold    int
+	blockSize        int
+	cacheQuery       map[string]func([]int) int
+	// ring buffer of code-arrival timestamps (circular, capacity = ringSize)
+	ringBuffer []int64
+	ringSize   int
+	ringHead   int // index of next write position
+	ringFill   int // number of valid entries currently in ring
+	// latch state (sentinel 0 = never fired; only assigned inside Decide)
+	lastFireUs int64
+}
+
+// NewContentBurstLatchAdaptivePrefixDecider creates a ContentBurstLatchAdaptivePrefixDecider.
+// Invariants (R3 fail-loud): all numeric params >= 0, blockSize > 0, ringSize >= 1,
+// ringSize >= burstThreshold.
+func NewContentBurstLatchAdaptivePrefixDecider(contentThreshold int, burstWindowUs int64, burstThreshold int, latchDurationUs int64, lowThreshold, highThreshold, blockSize, ringSize int, cacheQuery map[string]func([]int) int) *ContentBurstLatchAdaptivePrefixDecider {
+	if contentThreshold < 0 {
+		panic(fmt.Sprintf("NewContentBurstLatchAdaptivePrefixDecider: contentThreshold must be >= 0, got %d", contentThreshold))
+	}
+	if burstWindowUs < 0 {
+		panic(fmt.Sprintf("NewContentBurstLatchAdaptivePrefixDecider: burstWindowUs must be >= 0, got %d", burstWindowUs))
+	}
+	if burstThreshold < 1 {
+		panic(fmt.Sprintf("NewContentBurstLatchAdaptivePrefixDecider: burstThreshold must be >= 1, got %d", burstThreshold))
+	}
+	if latchDurationUs < 0 {
+		panic(fmt.Sprintf("NewContentBurstLatchAdaptivePrefixDecider: latchDurationUs must be >= 0, got %d", latchDurationUs))
+	}
+	if lowThreshold < 0 {
+		panic(fmt.Sprintf("NewContentBurstLatchAdaptivePrefixDecider: lowThreshold must be >= 0, got %d", lowThreshold))
+	}
+	if highThreshold < 0 {
+		panic(fmt.Sprintf("NewContentBurstLatchAdaptivePrefixDecider: highThreshold must be >= 0, got %d", highThreshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewContentBurstLatchAdaptivePrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	if ringSize < 1 {
+		panic(fmt.Sprintf("NewContentBurstLatchAdaptivePrefixDecider: ringSize must be >= 1, got %d", ringSize))
+	}
+	// Note: burstThreshold > ringSize is intentionally allowed — it makes the
+	// burst count structurally unreachable (count <= ringFill <= ringSize < burstThreshold),
+	// producing vacuous behavior identical to PrefixThresholdDecider(lowThreshold).
+	// This is the control-negative configuration for experiments (A2 arm).
+	return &ContentBurstLatchAdaptivePrefixDecider{
+		contentThreshold: contentThreshold,
+		burstWindowUs:    burstWindowUs,
+		burstThreshold:   burstThreshold,
+		latchDurationUs:  latchDurationUs,
+		lowThreshold:     lowThreshold,
+		highThreshold:    highThreshold,
+		blockSize:        blockSize,
+		cacheQuery:       cacheQuery,
+		ringBuffer:       make([]int64, ringSize),
+		ringSize:         ringSize,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens exceeds the threshold
+// selected by the burst-count latch state machine. When nonCachedTokens >=
+// contentThreshold, the arrival timestamp is appended to the ring buffer and
+// the count of entries within the last burstWindowUs is computed; if count >=
+// burstThreshold, lastFireUs is refreshed. The latch is active while
+// Clock − lastFireUs < latchDurationUs.
+func (d *ContentBurstLatchAdaptivePrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+
+	if nonCachedTokens >= d.contentThreshold {
+		// Append current timestamp to ring buffer (circular, overwrite oldest).
+		d.ringBuffer[d.ringHead] = state.Clock
+		d.ringHead = (d.ringHead + 1) % d.ringSize
+		if d.ringFill < d.ringSize {
+			d.ringFill++
+		}
+		// Count entries within the burst window.
+		windowStart := state.Clock - d.burstWindowUs
+		count := 0
+		for i := 0; i < d.ringFill; i++ {
+			ts := d.ringBuffer[(d.ringHead-1-i+d.ringSize)%d.ringSize]
+			if ts > windowStart {
+				count++
+			}
+		}
+		if count >= d.burstThreshold {
+			d.lastFireUs = state.Clock
+		}
+	}
+
+	latchActive := d.lastFireUs > 0 && state.Clock-d.lastFireUs < d.latchDurationUs
+	threshold := d.lowThreshold
+	if latchActive {
+		threshold = d.highThreshold
+	}
+	return DisaggregationDecision{Disaggregate: nonCachedTokens > threshold}
+}
