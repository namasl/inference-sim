+// ClusterIfrAndGatedPrefixDecider is identical to ClusterIfrGatedPrefixDecider
+// except it uses an AND combinator for the cluster-IFR clause instead of OR:
+//
+//	nonCachedTokens > threshold
+//	&& (selected.QueueDepth >= queueGate || selected.transientKvUtil >= kvGate)
+//	&& sum_p(p.InFlightRequests) >= clusterIfrGate
