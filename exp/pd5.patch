+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewClusterIfrAndGatedPrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	if queueGate < 0 {
+		panic(fmt.Sprintf("NewClusterIfrAndGatedPrefixDecider: queueGate must be >= 0, got %d", queueGate))
+	}
+	if kvGate < 0 {
+		panic(fmt.Sprintf("NewClusterIfrAndGatedPrefixDecider: kvGate must be >= 0, got %f", kvGate))
+	}
+	if kvGate > 2.0 {
+		panic(fmt.Sprintf("NewClusterIfrAndGatedPrefixDecider: kvGate must be <= 2.0, got %f", kvGate))
+	}
+	if clusterIfrGate < 0 {
