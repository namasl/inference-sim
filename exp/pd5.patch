+// Decide returns Disaggregate=true when nonCachedTokens exceeds the threshold
+// selected by the two-latch state machine. The short latch fires on every burst;
+// the long latch fires only when a second burst occurs within upgradeWindowUs of
+// the previous burst. The active threshold is highThreshold when either latch is
+// active, lowThreshold otherwise.
+func (d *TwoLatchBurstAdaptivePrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
