+// CacheAwareKvGatedPrefixDecider extends LoadKvGatedPrefixDecider by subtracting
+// the request's own prefix-cache contribution from KvTokensInUse before normalizing
+// to a "transient KV utilization". This isolates KV held by current active decode
+// work from KV held by passively cached prefix — fixing the RP-33 failure mode where
+// LRU-pinned shared prefixes elevate raw KVUtilization on otherwise-idle pods.
+//
+// Formula:
+//
+//	nonCachedTokens    = len(req.InputTokens) − cachedBlocks × blockSize
+//	cachedTokens       = cachedBlocks × blockSize
+//	transientKvTokens  = max(0, KvTokensInUse − cachedTokens)
+//	transientKvUtil    = transientKvTokens / TotalKvCapacityTokens  (0 if capacity ≤ 0)
+//	gateFires          = (selected.QueueDepth >= queueGate) || (transientKvUtil >= kvGate)
+//	Disaggregate       = (nonCachedTokens > threshold) && gateFires
+//
+// Degenerate cases:
+//   - kvGate=2.0: transientKvUtil ∈ [0,1] never fires → gate ≡ QD>=queueGate →
+//     byte-equivalent to LoadGatedPrefix(selected, queueGate)
+//
+// mode must be "selected". pool-sum and max modes are excluded per RP-16/RP-19.
+type CacheAwareKvGatedPrefixDecider struct {
+	threshold  int
+	blockSize  int
+	queueGate  int
+	kvGate     float64
+	cacheQuery map[string]func([]int) int
+}
+
+// NewCacheAwareKvGatedPrefixDecider creates a CacheAwareKvGatedPrefixDecider.
+// Invariants (R3 fail-loud): threshold >= 0, blockSize > 0, queueGate >= 0,
+// kvGate in [0, 2.0], mode == "selected".
+func NewCacheAwareKvGatedPrefixDecider(threshold, blockSize, queueGate int, kvGate float64, mode string, cacheQuery map[string]func([]int) int) *CacheAwareKvGatedPrefixDecider {
+	if threshold < 0 {
+		panic(fmt.Sprintf("NewCacheAwareKvGatedPrefixDecider: threshold must be >= 0, got %d", threshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewCacheAwareKvGatedPrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	if queueGate < 0 {
+		panic(fmt.Sprintf("NewCacheAwareKvGatedPrefixDecider: queueGate must be >= 0, got %d", queueGate))
+	}
+	if kvGate < 0 {
+		panic(fmt.Sprintf("NewCacheAwareKvGatedPrefixDecider: kvGate must be >= 0, got %f", kvGate))
+	}
+	if kvGate > 2.0 {
+		panic(fmt.Sprintf("NewCacheAwareKvGatedPrefixDecider: kvGate must be <= 2.0, got %f", kvGate))
+	}
+	if mode != "selected" {
+		panic(fmt.Sprintf("NewCacheAwareKvGatedPrefixDecider: mode must be \"selected\", got %q (pool-sum and max aggregation modes are not supported; see RP-16/RP-19)", mode))
+	}
+	return &CacheAwareKvGatedPrefixDecider{
+		threshold:  threshold,
+		blockSize:  blockSize,
+		queueGate:  queueGate,
+		kvGate:     kvGate,
+		cacheQuery: cacheQuery,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens > threshold AND
+// (selected.QueueDepth >= queueGate OR transientKvUtil >= kvGate).
+// transientKvUtil = max(0, KvTokensInUse - cachedBlocks*blockSize) / TotalKvCapacityTokens,
+// isolating active-decode KV pressure from passively cached prefix blocks.
+//
+// Early returns (all yielding Disaggregate=false):
+//   - len(req.InputTokens) == 0
+//   - state == nil
+//   - state.SelectedInstance == "" (no upstream selection)
+//   - cacheQuery is nil, or the selected instance is missing from the map,
+//     or its closure is nil
+//   - no snapshot in state.Snapshots matches state.SelectedInstance
+func (d *CacheAwareKvGatedPrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	if nonCachedTokens <= d.threshold {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Find the selected snapshot by ID (read-only linear scan).
+	var selectedSnap *RoutingSnapshot
+	for i := range state.Snapshots {
+		if state.Snapshots[i].ID == state.SelectedInstance {
+			selectedSnap = &state.Snapshots[i]
+			break
+		}
+	}
+	if selectedSnap == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedTokens := int64(cachedBlocks * d.blockSize)
+	transientKvTokens := selectedSnap.KvTokensInUse - cachedTokens
+	if transientKvTokens < 0 {
+		transientKvTokens = 0
+	}
+	var transientKvUtil float64
+	if selectedSnap.TotalKvCapacityTokens > 0 {
+		transientKvUtil = float64(transientKvTokens) / float64(selectedSnap.TotalKvCapacityTokens)
+	}
+	gateFires := (selectedSnap.QueueDepth >= d.queueGate) || (transientKvUtil >= d.kvGate)
+	return DisaggregationDecision{Disaggregate: gateFires}
+}
