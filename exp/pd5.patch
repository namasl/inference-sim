+// TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_FireBeforeRelease verifies that
+// the fire branch is evaluated before the release branch: a single observation that fires
+// the gate does not also immediately release in the same call.
+func TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_FireBeforeRelease(t *testing.T) {
+	trivialCache := map[string]func([]int) int{"decode_0": func([]int) int { return 0 }}
+	// latchDuration=0: any elapsed time >= 0, so if release were checked first, it would
+	// release on the same call that fires. With fire-before-release, fire sets lastFireUs
+	// and highState=true; the release check sees elapsed=0 which is >= 0 and would release —
+	// UNLESS the release check uses the ELSE branch (only checked when NOT firing this tick).
+	d := NewPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider(1, 1, 0, 0, 4096, 16, trivialCache)
+	req := &Request{ID: "req", InputTokens: make([]int, 100)}
+
+	// First call: IFR=1 → fires; since elapsed = 0 == latchDuration, the release
+	// branch must NOT run when the fire branch runs (else-if semantics).
+	// With the correct ordering, highState should be true after this call.
+	d.Decide(req, stateWithPrefillIFR(1, 1000))
+	if !d.highState {
+		t.Error("fire-before-release: on a firing observation, highState should remain true even when latchDuration=0")
+	}
+}
