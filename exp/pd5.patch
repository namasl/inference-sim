+// TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_LatchFireAndHold verifies
+// that once avgBp >= gateUpBp, the decider latches to highThreshold and stays there
+// even when subsequent observations show IFR=0 (as long as latch has not expired).
+func TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_LatchFireAndHold(t *testing.T) {
+	trivialCache := map[string]func([]int) int{"decode_0": func([]int) int { return 0 }}
+	// windowSize=1, gateUpBp=1 (fires immediately on any IFR>0), latchDuration=10s
+	d := NewPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider(1, 1, 10_000_000, 0, 4096, 16, trivialCache)
+	req := &Request{ID: "req", InputTokens: make([]int, 5000)} // nonCached=5000 > 4096 → disagg when threshold=4096
+
+	// Before fire: IFR=0 → avgBp=0 < gateUpBp=1 → lowThreshold=0; nonCached=5000 > 0 → disagg
+	if !d.Decide(req, stateWithPrefillIFR(0, 0)).Disaggregate {
+		t.Error("before latch: expected disaggregate=true because nonCached=5000 > lowThreshold=0")
+	}
+
+	// Fire: IFR=1 → avgBp=10000 >= 1 → highState=true; nonCached=5000 > 4096 → disagg
+	if !d.Decide(req, stateWithPrefillIFR(1, 1_000_000)).Disaggregate {
+		t.Error("on latch fire: expected disaggregate=true")
+	}
+	if !d.highState {
+		t.Error("after fire: expected highState=true")
+	}
+
+	// Hold: IFR=0, clock=2s (within 10s latch) → still highState; nonCached=5000 > 4096 → disagg
+	smallReq := &Request{ID: "small", InputTokens: make([]int, 100)} // nonCached=100 <= 4096 → colocate when highState
+	if d.Decide(smallReq, stateWithPrefillIFR(0, 2_000_000)).Disaggregate {
+		t.Error("during latch hold: expected colocate (false) for small request when highState=true, highThreshold=4096")
+	}
+	if !d.highState {
+		t.Error("during latch hold: highState should remain true")
+	}
+}
