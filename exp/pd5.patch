+		panic(fmt.Sprintf("NewClusterTransientKvGatedPrefixDecider: queueGate must be >= 0, got %d", queueGate))
+	}
+	if kvGate < 0 || kvGate > 2.0 {
+		panic(fmt.Sprintf("NewClusterTransientKvGatedPrefixDecider: kvGate must be in [0, 2.0], got %f", kvGate))
+	}
+	if clusterKvGate < 0 || clusterKvGate > 2.0 {
+		panic(fmt.Sprintf("NewClusterTransientKvGatedPrefixDecider: clusterKvGate must be in [0, 2.0], got %f", clusterKvGate))
+	}
