+		panic(fmt.Sprintf("NewPrefillIfrDutycycleSchmittAdaptivePrefixDecider: gateDownBp (%d) must be <= gateUpBp (%d)", gateDownBp, gateUpBp))
+	}
+	if lowThreshold < 0 {
+		panic(fmt.Sprintf("NewPrefillIfrDutycycleSchmittAdaptivePrefixDecider: lowThreshold must be >= 0, got %d", lowThreshold))
+	}
+	if highThreshold < 0 {
+		panic(fmt.Sprintf("NewPrefillIfrDutycycleSchmittAdaptivePrefixDecider: highThreshold must be >= 0, got %d", highThreshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewPrefillIfrDutycycleSchmittAdaptivePrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	return &PrefillIfrDutycycleSchmittAdaptivePrefixDecider{
+		windowSize:    windowSize,
+		gateUpBp:      gateUpBp,
+		gateDownBp:    gateDownBp,
+		lowThreshold:  lowThreshold,
+		highThreshold: highThreshold,
+		blockSize:     blockSize,
+		cacheQuery:    cacheQuery,
+		buffer:        make([]int, windowSize),
+	}
+}
