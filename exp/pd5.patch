+// ClusterTransientKvGatedPrefixDecider extends ClusterKvGatedPrefixDecider by
+// subtracting each pod's per-request cache-hit contribution from the cluster
+// numerator before aggregating. This produces a topology-undiluted AND
+// cache-aware cluster signal: "what is the residual non-cache load across all
+// decode pods if I were routed to any of them?"
+//
+// Decide logic:
+//
+//	nonCachedTokens > threshold
+//	&& (selected.QueueDepth >= queueGate
+//	    || selected.transientKvUtil >= kvGate
+//	    || clusterTransientKvUtil >= clusterKvGate)
+//
+// where:
+//   - selected.transientKvUtil = max(0, KvTokensInUse - cachedBlocks(req)*blockSize) / cap
+//     (same as CacheAwareKvGatedPrefixDecider)
+//   - clusterTransientKvUtil = sum_p(max(0, p.KvTokensInUse - cacheQueryFn[p](req.InputTokens)*blockSize))
+//     / sum_p(p.TotalKvCapacityTokens)
+//
+// Degenerate cases:
+//   - clusterKvGate=2.0: clusterTransientKvUtil ∈ [0,1] never fires → byte-identical to
+//     CacheAwareKvGatedPrefixDecider (ablation).
+//   - clusterKvGate=0.0: cluster-clause always fires → degenerate to
+//     prefix-threshold (always disaggregate when threshold exceeded).
+//
+// mode must be "selected". pool-sum and max modes are excluded per RP-16/RP-19.
+// RP-13: cacheQuery is used as a per-pod LOAD discount, not a session-warmth proxy.
+type ClusterTransientKvGatedPrefixDecider struct {
+	threshold     int
+	blockSize     int
+	queueGate     int
+	kvGate        float64
+	clusterKvGate float64
+	cacheQuery    map[string]func([]int) int
+}
