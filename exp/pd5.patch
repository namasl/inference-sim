+// ContentLatchAdaptivePrefixDecider disaggregates a request based on a
+// per-request content gate: the latch fires when the current request's
+// nonCachedTokens >= contentThreshold, refreshing lastFireUs. The threshold
+// used for the disaggregation test is highThreshold while the latch is active
+// (Clock − lastFireUs < latchDurationUs) and lowThreshold otherwise.
+//
+// Unlike the IFR-based timed-latch sibling, this decider does NOT read
+// PrefillSnapshots — the fire signal is the per-request input size, which
+// is synchronous and INV-9-safe. Chat requests (small nonCachedTokens)
+// cannot fire the gate when contentThreshold is chosen above typical chat
+// sizes, breaking the iter-13 self-defeating re-fire cycle (RP-33/34/35).
+type ContentLatchAdaptivePrefixDecider struct {
+	contentThreshold int
+	latchDurationUs  int64
+	lowThreshold     int
+	highThreshold    int
+	blockSize        int
+	cacheQuery       map[string]func([]int) int
+	// latch state (sentinel 0 = never fired; only assigned inside Decide)
+	lastFireUs int64
+}
+
+// NewContentLatchAdaptivePrefixDecider creates a ContentLatchAdaptivePrefixDecider.
+// Invariants (R3 fail-loud): contentThreshold >= 0, latchDurationUs >= 0,
+// lowThreshold >= 0, highThreshold >= 0, blockSize > 0.
+func NewContentLatchAdaptivePrefixDecider(contentThreshold int, latchDurationUs int64, lowThreshold, highThreshold, blockSize int, cacheQuery map[string]func([]int) int) *ContentLatchAdaptivePrefixDecider {
+	if contentThreshold < 0 {
+		panic(fmt.Sprintf("NewContentLatchAdaptivePrefixDecider: contentThreshold must be >= 0, got %d", contentThreshold))
+	}
+	if latchDurationUs < 0 {
+		panic(fmt.Sprintf("NewContentLatchAdaptivePrefixDecider: latchDurationUs must be >= 0, got %d", latchDurationUs))
+	}
+	if lowThreshold < 0 {
+		panic(fmt.Sprintf("NewContentLatchAdaptivePrefixDecider: lowThreshold must be >= 0, got %d", lowThreshold))
+	}
+	if highThreshold < 0 {
+		panic(fmt.Sprintf("NewContentLatchAdaptivePrefixDecider: highThreshold must be >= 0, got %d", highThreshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewContentLatchAdaptivePrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	return &ContentLatchAdaptivePrefixDecider{
+		contentThreshold: contentThreshold,
+		latchDurationUs:  latchDurationUs,
+		lowThreshold:     lowThreshold,
+		highThreshold:    highThreshold,
+		blockSize:        blockSize,
+		cacheQuery:       cacheQuery,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens exceeds the threshold
+// selected by the content-aware latch state machine. The latch fires when the
+// current request's nonCachedTokens >= contentThreshold, refreshing lastFireUs.
+// The latch is active while Clock − lastFireUs < latchDurationUs.
+func (d *ContentLatchAdaptivePrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	// Fire branch first: refresh latch when this request exceeds contentThreshold.
+	if nonCachedTokens >= d.contentThreshold {
+		d.lastFireUs = state.Clock
+	}
+	latchActive := d.lastFireUs > 0 && state.Clock-d.lastFireUs < d.latchDurationUs
+	threshold := d.lowThreshold
+	if latchActive {
+		threshold = d.highThreshold
+	}
+	return DisaggregationDecision{Disaggregate: nonCachedTokens > threshold}
+}
