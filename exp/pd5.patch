+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+
+	if nonCachedTokens >= d.contentThreshold {
+		// Append current timestamp to ring buffer (circular, overwrite oldest).
+		d.ringBuffer[d.ringHead] = state.Clock
+		d.ringHead = (d.ringHead + 1) % d.ringSize
+		if d.ringFill < d.ringSize {
+			d.ringFill++
+		}
+		// Count entries within the burst window.
+		windowStart := state.Clock - d.burstWindowUs
+		count := 0
+		for i := 0; i < d.ringFill; i++ {
+			ts := d.ringBuffer[(d.ringHead-1-i+d.ringSize)%d.ringSize]
+			if ts > windowStart {
+				count++
+			}
+		}
+		if count >= d.burstThreshold {
+			// Burst fired: check if this is a repeated burst (upgrade).
+			if d.lastBurstFireUs > 0 && state.Clock-d.lastBurstFireUs < d.upgradeWindowUs {
+				d.longLatchFireUs = state.Clock
+			}
+			d.lastBurstFireUs = state.Clock
+		}
+	}
+
+	shortActive := d.lastBurstFireUs > 0 && state.Clock-d.lastBurstFireUs < d.shortLatchDurationUs
+	longActive := d.longLatchFireUs > 0 && state.Clock-d.longLatchFireUs < d.longLatchDurationUs
+	threshold := d.lowThreshold
+	if shortActive || longActive {
+		threshold = d.highThreshold
+	}
+	return DisaggregationDecision{Disaggregate: nonCachedTokens > threshold}
+}
+
+// RollingCodeRateAdaptivePrefixDecider disaggregates based on a sliding-window
+// count of high-content arrivals. Unlike TwoLatchBurstAdaptivePrefixDecider,
+// there is NO latch state — the threshold is selected on every Decide call
+// based solely on whether the rolling count >= rateThreshold. This uses
+// VARIANCE-based regime discrimination: poisson arrivals at code=10/s produce
+// a 2s-window count with μ=20, σ≈4.47 so rateThreshold=30 fires ~1.7% of
+// the time; weibull macro-bursts exceed 30 routinely via DES micro-clustering.
+//
+// Does NOT read RoutingSnapshot fields (INV-7 safe). Does NOT read
+// req.OutputTokens (INV-9 safe). Ring-buffer mutation is per-request
+// deterministic (INV-6).
+type RollingCodeRateAdaptivePrefixDecider struct {
+	contentThreshold int
+	windowUs         int64
+	rateThreshold    int
+	lowThreshold     int
+	highThreshold    int
+	blockSize        int
+	cacheQuery       map[string]func([]int) int
+	ringBuffer       []int64
+	ringSize         int
+	ringHead         int
+	ringFill         int
+}
+
+// NewRollingCodeRateAdaptivePrefixDecider creates a RollingCodeRateAdaptivePrefixDecider.
+// R3 fail-loud: contentThreshold >= 0, windowUs >= 0, rateThreshold >= 1,
+// lowThreshold >= 0, highThreshold >= 0, blockSize > 0, ringSize >= 1.
+// rateThreshold > ringSize is intentionally allowed (vacuous control-negative arm).
+func NewRollingCodeRateAdaptivePrefixDecider(contentThreshold int, windowUs int64, rateThreshold, lowThreshold, highThreshold, blockSize, ringSize int, cacheQuery map[string]func([]int) int) *RollingCodeRateAdaptivePrefixDecider {
+	if contentThreshold < 0 {
+		panic(fmt.Sprintf("NewRollingCodeRateAdaptivePrefixDecider: contentThreshold must be >= 0, got %d", contentThreshold))
+	}
+	if windowUs < 0 {
+		panic(fmt.Sprintf("NewRollingCodeRateAdaptivePrefixDecider: windowUs must be >= 0, got %d", windowUs))
+	}
+	if rateThreshold < 1 {
+		panic(fmt.Sprintf("NewRollingCodeRateAdaptivePrefixDecider: rateThreshold must be >= 1, got %d", rateThreshold))
+	}
+	if lowThreshold < 0 {
+		panic(fmt.Sprintf("NewRollingCodeRateAdaptivePrefixDecider: lowThreshold must be >= 0, got %d", lowThreshold))
+	}
+	if highThreshold < 0 {
+		panic(fmt.Sprintf("NewRollingCodeRateAdaptivePrefixDecider: highThreshold must be >= 0, got %d", highThreshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewRollingCodeRateAdaptivePrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	if ringSize < 1 {
+		panic(fmt.Sprintf("NewRollingCodeRateAdaptivePrefixDecider: ringSize must be >= 1, got %d", ringSize))
+	}
+	// rateThreshold > ringSize is intentionally allowed — makes count structurally
+	// unreachable (count <= ringFill <= ringSize < rateThreshold), producing vacuous
+	// behavior identical to PrefixThresholdDecider(lowThreshold).
+	return &RollingCodeRateAdaptivePrefixDecider{
+		contentThreshold: contentThreshold,
+		windowUs:         windowUs,
+		rateThreshold:    rateThreshold,
+		lowThreshold:     lowThreshold,
+		highThreshold:    highThreshold,
+		blockSize:        blockSize,
+		cacheQuery:       cacheQuery,
+		ringBuffer:       make([]int64, ringSize),
+		ringSize:         ringSize,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens exceeds the threshold
+// selected by the rolling-rate gate. If the sliding-window count of high-content
+// arrivals (nonCachedTokens >= contentThreshold) within windowUs >= rateThreshold,
+// highThreshold is used; otherwise lowThreshold. No latch state.
+func (d *RollingCodeRateAdaptivePrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+
+	if nonCachedTokens >= d.contentThreshold {
+		// Append current timestamp to ring buffer (circular, overwrite oldest).
+		d.ringBuffer[d.ringHead] = state.Clock
+		d.ringHead = (d.ringHead + 1) % d.ringSize
+		if d.ringFill < d.ringSize {
+			d.ringFill++
+		}
+	}
+
+	// Count ring entries within the sliding window.
+	windowStart := state.Clock - d.windowUs
+	count := 0
+	for i := 0; i < d.ringFill; i++ {
+		ts := d.ringBuffer[(d.ringHead-1-i+d.ringSize)%d.ringSize]
+		if ts > windowStart {
+			count++
+		}
+	}
+
+	threshold := d.lowThreshold
+	if count >= d.rateThreshold {
+		threshold = d.highThreshold
+	}
+	return DisaggregationDecision{Disaggregate: nonCachedTokens > threshold}
+}
+
+// RollingInputRateAdaptivePrefixDecider disaggregates based on a sliding-window
+// count of high-input-length arrivals. Identical in structure to
+// RollingCodeRateAdaptivePrefixDecider except the content gate uses
+// len(req.InputTokens) >= contentThreshold instead of
+// nonCachedTokens >= contentThreshold. Raw input length is invariant to KV
+// cache state (set once at workload generation), making this gate reliable
+// even when a shared code prefix is cached at all decode pods.
+//
+// Does NOT read RoutingSnapshot fields (INV-7 safe). Does NOT read
+// req.OutputTokens (INV-9 safe). Ring-buffer mutation is per-request
+// deterministic (INV-6).
+type RollingInputRateAdaptivePrefixDecider struct {
+	contentThreshold int
+	windowUs         int64
+	rateThreshold    int
+	lowThreshold     int
+	highThreshold    int
+	blockSize        int
+	cacheQuery       map[string]func([]int) int
+	ringBuffer       []int64
+	ringSize         int
+	ringHead         int
+	ringFill         int
+}
+
+// NewRollingInputRateAdaptivePrefixDecider creates a RollingInputRateAdaptivePrefixDecider.
+// R3 fail-loud: contentThreshold >= 0, windowUs >= 0, rateThreshold >= 1,
+// lowThreshold >= 0, highThreshold >= 0, blockSize > 0, ringSize >= 1.
+// rateThreshold > ringSize is intentionally allowed (vacuous control-negative arm).
+func NewRollingInputRateAdaptivePrefixDecider(contentThreshold int, windowUs int64, rateThreshold, lowThreshold, highThreshold, blockSize, ringSize int, cacheQuery map[string]func([]int) int) *RollingInputRateAdaptivePrefixDecider {
+	if contentThreshold < 0 {
+		panic(fmt.Sprintf("NewRollingInputRateAdaptivePrefixDecider: contentThreshold must be >= 0, got %d", contentThreshold))
+	}
+	if windowUs < 0 {
+		panic(fmt.Sprintf("NewRollingInputRateAdaptivePrefixDecider: windowUs must be >= 0, got %d", windowUs))
+	}
+	if rateThreshold < 1 {
+		panic(fmt.Sprintf("NewRollingInputRateAdaptivePrefixDecider: rateThreshold must be >= 1, got %d", rateThreshold))
+	}
+	if lowThreshold < 0 {
+		panic(fmt.Sprintf("NewRollingInputRateAdaptivePrefixDecider: lowThreshold must be >= 0, got %d", lowThreshold))
+	}
+	if highThreshold < 0 {
+		panic(fmt.Sprintf("NewRollingInputRateAdaptivePrefixDecider: highThreshold must be >= 0, got %d", highThreshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewRollingInputRateAdaptivePrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	if ringSize < 1 {
+		panic(fmt.Sprintf("NewRollingInputRateAdaptivePrefixDecider: ringSize must be >= 1, got %d", ringSize))
+	}
+	// rateThreshold > ringSize is intentionally allowed — makes count structurally
+	// unreachable (count <= ringFill <= ringSize < rateThreshold), producing vacuous
+	// behavior identical to PrefixThresholdDecider(lowThreshold).
+	return &RollingInputRateAdaptivePrefixDecider{
+		contentThreshold: contentThreshold,
+		windowUs:         windowUs,
+		rateThreshold:    rateThreshold,
+		lowThreshold:     lowThreshold,
+		highThreshold:    highThreshold,
+		blockSize:        blockSize,
+		cacheQuery:       cacheQuery,
+		ringBuffer:       make([]int64, ringSize),
+		ringSize:         ringSize,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens exceeds the threshold
+// selected by the rolling-rate gate. If the sliding-window count of
+// high-input-length arrivals (len(req.InputTokens) >= contentThreshold) within
+// windowUs >= rateThreshold, highThreshold is used; otherwise lowThreshold.
+// No latch state. The nonCachedTokens value (for the final disaggregation
+// decision) is computed via cacheQuery after the gate check.
+func (d *RollingInputRateAdaptivePrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+
+	// Gate on raw input length — invariant to KV cache state.
+	if len(req.InputTokens) >= d.contentThreshold {
+		// Append current timestamp to ring buffer (circular, overwrite oldest).
+		d.ringBuffer[d.ringHead] = state.Clock
+		d.ringHead = (d.ringHead + 1) % d.ringSize
+		if d.ringFill < d.ringSize {
+			d.ringFill++
+		}
+	}
+
+	// Count ring entries within the sliding window.
+	windowStart := state.Clock - d.windowUs
+	count := 0
+	for i := 0; i < d.ringFill; i++ {
+		ts := d.ringBuffer[(d.ringHead-1-i+d.ringSize)%d.ringSize]
+		if ts > windowStart {
+			count++
+		}
+	}
+
+	threshold := d.lowThreshold
+	if count >= d.rateThreshold {
+		threshold = d.highThreshold
+	}
+
+	// Compute nonCachedTokens for the final disaggregation decision.
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	return DisaggregationDecision{Disaggregate: nonCachedTokens > threshold}
+}
