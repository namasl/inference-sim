+// PrefillIfrDutycycleTimedLatchAdaptivePrefixDecider (iter-13) is a time-bounded
+// latch variant of PrefillIfrDutycycleSchmittAdaptivePrefixDecider. It replaces
+// the level-based release condition (avgBp < gateDownBp) with a wall-clock
+// release condition (state.Clock - lastFireUs >= latchDurationUs).
+//
+// State machine:
+//   - highState=false → highState=true when avgBp >= gateUpBp (fire branch)
+//   - highState=true  → highState=false when Clock−lastFireUs >= latchDurationUs
+//     and avgBp < gateUpBp (release branch; mutually exclusive with fire branch)
+//   - threshold = highThreshold if highState else lowThreshold
+//
+// The fire branch is always checked BEFORE the release branch (else-if semantics):
+// on an observation where avgBp >= gateUpBp, lastFireUs is refreshed and
+// highState=true is set (or maintained); the release branch is not evaluated.
+// This ensures that a re-firing observation within the latch window extends the
+// latch duration without prematurely releasing.
+//
+// When latchDurationUs is very large (e.g. 10^12 µs ≈ 11.5 days), the release
+// condition is unreachable within a ~10 s simulation, producing byte-identical
+// behavior to PrefillIfrDutycycleSchmittAdaptivePrefixDecider with gateDownBp=0
+// (permanent latch). This equivalence is the A2 control-negative wiring check.
+//
+// All INV-6/INV-9/RP-15 properties of the parent type are preserved:
+// ring-buffer mutations are identical to the Schmitt sibling; OutputTokens is
+// never read; IFR reads are observability-only.
+type PrefillIfrDutycycleTimedLatchAdaptivePrefixDecider struct {
+	windowSize      int
+	gateUpBp        int
+	latchDurationUs int64
+	lowThreshold    int
+	highThreshold   int
+	blockSize       int
+	cacheQuery      map[string]func([]int) int
+	// ring buffer state (INV-6: mutated only inside Decide, single-threaded)
+	buffer    []int
+	head      int
+	sum       int
+	fillCount int
+	// timed-latch state
+	highState   bool
+	lastFireUs  int64 // sentinel 0 = never fired; only assigned inside Decide
+}
+
+// NewPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider creates a
+// PrefillIfrDutycycleTimedLatchAdaptivePrefixDecider.
+// Invariants (R3 fail-loud): windowSize > 0, gateUpBp >= 0, latchDurationUs >= 0,
