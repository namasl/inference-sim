+// Decide returns Disaggregate=true when nonCachedTokens exceeds the threshold
+// selected by the timed-latch state machine operating on the duty-cycle running
+// mean of the binarized prefill-pool IFR signal. Ring-buffer logic is identical
+// to PrefillIfrDutycycleSchmittAdaptivePrefixDecider; only the threshold dispatch
+// differs (time-bounded latch release instead of level-based release).
+func (d *PrefillIfrDutycycleTimedLatchAdaptivePrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if len(state.PrefillSnapshots) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	prefillIfr := 0
+	for i := range state.PrefillSnapshots {
+		if state.PrefillSnapshots[i].InFlightRequests > prefillIfr {
+			prefillIfr = state.PrefillSnapshots[i].InFlightRequests
+		}
+	}
+	bit := 0
+	if prefillIfr > 0 {
+		bit = 1
+	}
+	d.sum -= d.buffer[d.head]
+	d.buffer[d.head] = bit
+	d.sum += bit
+	d.head = (d.head + 1) % d.windowSize
+	if d.fillCount < d.windowSize {
+		d.fillCount++
+	}
+	fill := d.fillCount
+	if fill == 0 {
+		fill = 1
+	}
+	avgBp := d.sum * 10000 / fill
+	// Timed-latch state transitions: fire branch checked BEFORE release branch.
+	if avgBp >= d.gateUpBp {
+		d.highState = true
+		d.lastFireUs = state.Clock
+	} else if d.highState && state.Clock-d.lastFireUs >= d.latchDurationUs {
+		d.highState = false
+	}
