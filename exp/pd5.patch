+// TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_INV9_OracleBoundary verifies
+// that Decide output is identical regardless of OutputTokens (INV-9).
+func TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_INV9_OracleBoundary(t *testing.T) {
+	trivialCache := map[string]func([]int) int{"decode_0": func([]int) int { return 0 }}
+	d := NewPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider(20, 1000, 2_000_000, 0, 4096, 16, trivialCache)
+	req1 := &Request{ID: "r1", InputTokens: make([]int, 100), OutputTokens: nil}
+	req2 := &Request{ID: "r2", InputTokens: make([]int, 100), OutputTokens: make([]int, 9999)}
+	state := stateWithPrefillIFR(1, 1_000_000)
+
+	d1 := d.Decide(req1, state)
+	d2 := d.Decide(req2, state)
+	if d1.Disaggregate != d2.Disaggregate {
+		t.Errorf("INV-9 violation: decision differs with different OutputTokens (%v vs %v)", d1, d2)
+	}
+}
