+// TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_LargeLatchEquivalentToPermanentLatch
+// verifies that a very large latchDurationUs (10^12 µs) produces the same state transitions
+// as the Schmitt decider with gateDownBp=0 (permanent latch). This is the A2 wiring check.
+func TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_LargeLatchEquivalentToPermanentLatch(t *testing.T) {
+	trivialCache := map[string]func([]int) int{"decode_0": func([]int) int { return 0 }}
+	// Large latch: effectively permanent (10^12 µs ≈ 11.5 days > any 10s simulation)
+	dTimed := NewPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider(20, 1000, 1_000_000_000_000, 0, 4096, 16, trivialCache)
+	dPermanent := NewPrefillIfrDutycycleSchmittAdaptivePrefixDecider(20, 1000, 0, 0, 4096, 16, trivialCache)
+	req := &Request{ID: "req", InputTokens: make([]int, 5000)}
+
+	clocks := []int64{0, 100_000, 500_000, 1_000_000, 5_000_000, 9_000_000}
+	ifrs := []int{0, 0, 1, 0, 0, 0} // fire once at clock=500_000
+
+	for i, clock := range clocks {
+		state := &RouterState{
+			Snapshots:        []RoutingSnapshot{{ID: "decode_0"}},
+			SelectedInstance: "decode_0",
+			Clock:            clock,
+			PrefillSnapshots: []RoutingSnapshot{{ID: "prefill_0", InFlightRequests: ifrs[i]}},
+		}
+		dTimed.Decide(req, state)
+		dPermanent.Decide(req, state)
+		if dTimed.highState != dPermanent.highState {
+			t.Errorf("step %d (clock=%d, IFR=%d): timed.highState=%v != permanent.highState=%v",
+				i, clock, ifrs[i], dTimed.highState, dPermanent.highState)
+		}
+	}
+}
