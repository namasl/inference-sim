+	}
+	if ifrCeiling > 0 && ifrCeiling <= ifrGate {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: ifrCeiling (%d) must exceed ifrGate (%d) when non-zero; a ceiling at or below the gate collapses the ifrFires band to empty (use ifrCeiling=0 to disable the ceiling, or set ifrCeiling > ifrGate)", ifrCeiling, ifrGate))
+	}
+	if ifrMinTokens < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: ifrMinTokens must be >= 0, got %d", ifrMinTokens))
+	}
+	if kvCeiling < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: kvCeiling must be >= 0, got %f", kvCeiling))
+	}
+	if kvCeiling > 2.0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: kvCeiling must be <= 2.0, got %f", kvCeiling))
+	}
+	if kvCeiling > 0 && kvCeiling <= kvGate {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: kvCeiling (%f) must exceed kvGate (%f) when non-zero; a ceiling at or below the gate collapses the kvFires band to empty (use kvCeiling=0 to disable the ceiling, or set kvCeiling > kvGate)", kvCeiling, kvGate))
+	}
+	if admitCeiling < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: admitCeiling must be >= 0, got %f", admitCeiling))
+	}
+	if admitCeiling > 2.0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: admitCeiling must be <= 2.0, got %f", admitCeiling))
+	}
+	if admitCeiling > 0 && admitCeiling <= admitThreshold {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: admitCeiling (%f) must exceed admitThreshold (%f) when non-zero; a ceiling at or below the threshold collapses the admit band to empty (iter-45 design intent: use admitCeiling=0 to disable the ceiling, or set admitCeiling > admitThreshold)", admitCeiling, admitThreshold))
+	}
+	if roundIndexCap < 0 {
+		panic(fmt.Sprintf("NewAdmissionAndLongPrefillAwarePrefixDecider: roundIndexCap must be >= 0, got %d", roundIndexCap))
+	}
+	return &AdmissionAndLongPrefillAwarePrefixDecider{
+		threshold:            threshold,
+		blockSize:            blockSize,
+		queueGate:            queueGate,
+		kvGate:               kvGate,
+		kvCeiling:            kvCeiling,
+		admitThreshold:       admitThreshold,
+		admitCeiling:         admitCeiling,
+		longPrefillThreshold: longPrefillThreshold,
+		admitMinTokens:       admitMinTokens,
+		kvMinTokens:          kvMinTokens,
+		qdCircuitBreaker:     qdCircuitBreaker,
+		qdLowCircuitBreaker:  qdLowCircuitBreaker,
+		ifrGate:              ifrGate,
+		ifrCeiling:           ifrCeiling,
+		ifrMinTokens:         ifrMinTokens,
+		roundIndexCap:        roundIndexCap,
+		cacheQuery:           cacheQuery,
+	}
+}
+
+// Decide returns Disaggregate=true when:
+//   - nonCachedTokens > longPrefillThreshold (force-disagg, unconditional — NOT subject to either
+//     circuit breaker or the ifrFires clause; long-prefill protection is always active per RP-35/RP-63), OR
+//   - nonCachedTokens > threshold AND
+//     (QueueDepth >= queueGate OR transientKvUtil >= kvGate OR predictedUtil >= admitThreshold
+//      OR (ifrGate > 0 AND selectedSnap.InFlightRequests >= ifrGate))
+//     AND (qdCircuitBreaker == 0 OR selectedSnap.QueueDepth < qdCircuitBreaker)
+//     AND (qdLowCircuitBreaker == 0 OR selectedSnap.QueueDepth >= qdLowCircuitBreaker).
+//
+// ifrFires = (ifrMinTokens == 0 OR nonCachedTokens >= ifrMinTokens) AND ifrGate > 0 AND
+// selectedSnap.InFlightRequests >= ifrGate AND (ifrCeiling == 0 OR
+// selectedSnap.InFlightRequests < ifrCeiling)) is the fourth OR-clause (iter-52/iter-56/iter-57):
+// fires when the selected decode pod InFlightRequests is in [ifrGate, ifrCeiling) AND
+// nonCachedTokens >= ifrMinTokens. ifrGate == 0 short-circuits to false (vacuous; byte-identical
+// to iter-48 A2). ifrCeiling == 0 means no ceiling (vacuous; byte-identical to iter-55 A3).
+// ifrMinTokens == 0 means vacuous token-min (byte-identical to iter-56 A3). ifrMinTokens gates
+// the clause: when > 0, ifrFires fires only if nonCachedTokens >= ifrMinTokens, decoupling
+// cold round-0 (large nonCached) from warm follow-up rounds (small nonCached).
+// qdCircuitBreaker overrides the OR-combinator output to false when the selected decode pod
+// QueueDepth >= qdCircuitBreaker (iter-50, suppress at HIGH QD). The long-prefill force-disagg
+// branch executes before either breaker check and is exempted unconditionally.
+// qdLowCircuitBreaker overrides the OR-combinator output to false when the selected decode pod
+// QueueDepth < qdLowCircuitBreaker (iter-51, suppress at LOW QD; inverse direction). The two
+// breakers fire on disjoint QD bands and are order-independent.
+func (d *AdmissionAndLongPrefillAwarePrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	// Force-disaggregate branch: long prefills bypass per-pod gate (order preserved
+	// from LongPrefillAwarePrefixDecider — must precede threshold short-circuit).
+	if nonCachedTokens > d.longPrefillThreshold {
+		return DisaggregationDecision{Disaggregate: true}
+	}
+	if nonCachedTokens <= d.threshold {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Find the selected snapshot by ID (read-only linear scan).
+	var selectedSnap *RoutingSnapshot
+	for i := range state.Snapshots {
+		if state.Snapshots[i].ID == state.SelectedInstance {
+			selectedSnap = &state.Snapshots[i]
+			break
+		}
+	}
+	if selectedSnap == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Clause 1: QueueDepth gate.
+	qdFires := selectedSnap.QueueDepth >= d.queueGate
+	// Clause 2: transient KV utilization gate (cache-subtracted).
+	cachedTokens := int64(cachedBlocks * d.blockSize)
+	transientKvTokens := selectedSnap.KvTokensInUse - cachedTokens
+	if transientKvTokens < 0 {
+		transientKvTokens = 0
+	}
+	var transientKvUtil float64
+	if selectedSnap.TotalKvCapacityTokens > 0 {
+		transientKvUtil = float64(transientKvTokens) / float64(selectedSnap.TotalKvCapacityTokens)
+	}
+	// kvMinTokens gate: when > 0, kvFires fires only if nonCachedTokens >= kvMinTokens,
+	// decoupling cold round-0 (large nonCached) from warm follow-up rounds (small nonCached).
+	// kvMinTokens == 0 short-circuits to true (vacuous, byte-identical to prior iterations).
+	kvFires := (d.kvMinTokens == 0 || nonCachedTokens >= d.kvMinTokens) && transientKvUtil >= d.kvGate && (d.kvCeiling == 0 || transientKvUtil < d.kvCeiling)
+	// Clause 3: predictive admission gate (raw KvTokensInUse, not cache-subtracted).
+	// Cached blocks DO occupy admit headroom (intentional asymmetry with transient-KV clause).
+	// admitMinTokens gate: when > 0, admit fires only if nonCachedTokens >= admitMinTokens,
+	// decoupling cold round-0 (large nonCached) from warm follow-up rounds (small nonCached).
+	// admitCeiling gate (iter-45): when > 0, admit fires only when predictedUtil < admitCeiling,
+	// banding the admit clause to [admitThreshold, admitCeiling). admitCeiling == 0 is vacuous.
+	var admitFires bool
+	if selectedSnap.TotalKvCapacityTokens > 0 && (d.admitMinTokens == 0 || nonCachedTokens >= d.admitMinTokens) {
+		predictedUtil := float64(selectedSnap.KvTokensInUse+int64(nonCachedTokens)) / float64(selectedSnap.TotalKvCapacityTokens)
+		admitFires = predictedUtil >= d.admitThreshold &&
+			(d.admitCeiling == 0 || predictedUtil < d.admitCeiling)
+	}
+	// Clause 4: per-pod selected-decode InFlightRequests gate (iter-52/iter-56/iter-57).
+	// ifrGate == 0 short-circuits to false (vacuous; byte-identical to iter-48 A2 / iter-51 A3).
+	// ifrCeiling == 0 means vacuous ceiling (byte-identical to iter-55 A3 when ceiling not set).
+	// ifrMinTokens gate: when > 0, ifrFires fires only if nonCachedTokens >= ifrMinTokens,
+	// decoupling cold round-0 (large nonCached) from warm follow-up rounds (small nonCached).
+	// ifrMinTokens == 0 short-circuits to true (vacuous, byte-identical to iter-56 A3).
+	ifrFires := (d.ifrMinTokens == 0 || nonCachedTokens >= d.ifrMinTokens) && d.ifrGate > 0 && selectedSnap.InFlightRequests >= d.ifrGate && (d.ifrCeiling == 0 || selectedSnap.InFlightRequests < d.ifrCeiling)
+	decision := qdFires || kvFires || admitFires || ifrFires
+	if d.qdCircuitBreaker > 0 && selectedSnap.QueueDepth >= d.qdCircuitBreaker {
+		decision = false
+	}
+	if d.qdLowCircuitBreaker > 0 && selectedSnap.QueueDepth < d.qdLowCircuitBreaker {
+		decision = false
+	}
+	// roundIndexCap override (iter-59, RP-13/RP-45): when cap > 0 and the request is at
+	// a warm round (RoundIndex >= cap), suppress the OR-combinator decision. The long-prefill
+	// force-disagg early return above always runs before this point (RP-35/RP-63 preserved).
+	// cap == 0 is vacuous: this branch never executes, preserving byte-identity with iter-58.
+	if d.roundIndexCap > 0 && req.RoundIndex >= d.roundIndexCap {
+		decision = false
+	}
+	return DisaggregationDecision{Disaggregate: decision}
+}
+
+// compile-time interface compliance check
+var _ DisaggregationDecider = (*AdmissionAndLongPrefillAwarePrefixDecider)(nil)
+
+// IfrAdaptivePrefixDecider disaggregates a request based on a piecewise threshold
+// that adapts to the synchronous InFlightRequests (IFR) of the selected decode pod.
+// This is the campaign's first parameter-adaptive decider: instead of a binary gate
+// over a fixed threshold, the threshold itself is a function of pod load.
+//
+// Formula:
+//
+//	nonCachedTokens = len(req.InputTokens) − cachedBlocks × blockSize
+//	ifr             = selectedSnap.InFlightRequests  (INV-7 synchronous)
+//	threshold       = highThreshold  if ifr <= lowWatermark   (idle pod — colocate aggressively)
+//	                = midThreshold   if lowWatermark < ifr < highWatermark
+//	                = lowThreshold   if ifr >= highWatermark  (loaded pod — disagg every prefill)
+//	Disaggregate    = (nonCachedTokens > threshold)
+//
+// IFR is INV-7-synchronous (updated on every request event, not on the 50ms Periodic
+// cadence used by QueueDepth/BatchSize/KVUtilization). This makes the threshold
+// reactive to within-burst load changes, bypassing the RP-6 stale-snapshot failure
+// mode that disabled QD-based gating in iter-1.
+//
+// Factory invariants (R3): lowWatermark < highWatermark, both >= 0;
+// all thresholds >= 0 (no ordering required — A2 control-negative inverts them);
+// blockSize > 0.
+type IfrAdaptivePrefixDecider struct {
+	lowWatermark   int
+	highWatermark  int
+	lowThreshold   int
+	midThreshold   int
+	highThreshold  int
+	blockSize      int
+	cacheQuery     map[string]func([]int) int
+}
+
+// NewIfrAdaptivePrefixDecider creates an IfrAdaptivePrefixDecider.
+// Invariants (R3 fail-loud):
+//   - lowWatermark >= 0
+//   - highWatermark >= 0
+//   - lowWatermark < highWatermark
+//   - lowThreshold >= 0
+//   - midThreshold >= 0
+//   - highThreshold >= 0
+//   - blockSize > 0
+//
+// No ordering constraint is imposed on the thresholds: the A2 control-negative
+// arm deliberately inverts them (lowThreshold=4096, highThreshold=0) to test
+// that A1's gain is directionally caused by the IFR-direction mapping.
+//
+// cacheQuery may be nil (e.g. unit tests without cluster state); when nil or
+// when state.SelectedInstance is missing from the map, Decide returns
+// Disaggregate=false (conservative fallback).
+func NewIfrAdaptivePrefixDecider(lowWatermark, highWatermark, lowThreshold, midThreshold, highThreshold, blockSize int, cacheQuery map[string]func([]int) int) *IfrAdaptivePrefixDecider {
+	if lowWatermark < 0 {
+		panic(fmt.Sprintf("NewIfrAdaptivePrefixDecider: lowWatermark must be >= 0, got %d", lowWatermark))
+	}
+	if highWatermark < 0 {
+		panic(fmt.Sprintf("NewIfrAdaptivePrefixDecider: highWatermark must be >= 0, got %d", highWatermark))
+	}
+	if lowWatermark >= highWatermark {
+		panic(fmt.Sprintf("NewIfrAdaptivePrefixDecider: lowWatermark (%d) must be < highWatermark (%d)", lowWatermark, highWatermark))
+	}
+	if lowThreshold < 0 {
+		panic(fmt.Sprintf("NewIfrAdaptivePrefixDecider: lowThreshold must be >= 0, got %d", lowThreshold))
+	}
+	if midThreshold < 0 {
+		panic(fmt.Sprintf("NewIfrAdaptivePrefixDecider: midThreshold must be >= 0, got %d", midThreshold))
+	}
+	if highThreshold < 0 {
+		panic(fmt.Sprintf("NewIfrAdaptivePrefixDecider: highThreshold must be >= 0, got %d", highThreshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewIfrAdaptivePrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	return &IfrAdaptivePrefixDecider{
+		lowWatermark:  lowWatermark,
+		highWatermark: highWatermark,
+		lowThreshold:  lowThreshold,
+		midThreshold:  midThreshold,
+		highThreshold: highThreshold,
+		blockSize:     blockSize,
+		cacheQuery:    cacheQuery,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens exceeds the threshold
+// selected by the selected decode pod's synchronous InFlightRequests:
+//   - ifr <= lowWatermark  → highThreshold (idle pod, colocate aggressively)
+//   - lowWatermark < ifr < highWatermark → midThreshold
+//   - ifr >= highWatermark → lowThreshold (loaded pod, disagg every prefill)
+//
+// Early returns (all yielding Disaggregate=false):
+//   - len(req.InputTokens) == 0
+//   - state == nil
+//   - state.SelectedInstance == "" (no upstream selection)
+//   - cacheQuery is nil, or the selected instance is missing from the map,
+//     or its closure is nil
+//   - no snapshot in state.Snapshots matches state.SelectedInstance
+func (d *IfrAdaptivePrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	// Find the selected snapshot by ID (read-only linear scan).
+	var selectedSnap *RoutingSnapshot
+	for i := range state.Snapshots {
+		if state.Snapshots[i].ID == state.SelectedInstance {
+			selectedSnap = &state.Snapshots[i]
+			break
+		}
+	}
+	if selectedSnap == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Piecewise threshold selection based on synchronous IFR.
+	var threshold int
+	ifr := selectedSnap.InFlightRequests
+	switch {
+	case ifr <= d.lowWatermark:
+		threshold = d.highThreshold
+	case ifr >= d.highWatermark:
+		threshold = d.lowThreshold
+	default:
+		threshold = d.midThreshold
+	}
+	return DisaggregationDecision{Disaggregate: nonCachedTokens > threshold}
+}
+
+// compile-time interface compliance check
+var _ DisaggregationDecider = (*IfrAdaptivePrefixDecider)(nil)
+
+// ---------------------------------------------------------------------------
+// PrefillIfrAdaptivePrefixDecider (iter-5, prefill-ifr-adaptive-prefix)
+// ---------------------------------------------------------------------------
+
+// PrefillIfrAdaptivePrefixDecider disaggregates a request based on a 2-band
+// threshold that adapts to the **prefill pool's** synchronous InFlightRequests.
+// Unlike IfrAdaptivePrefixDecider (which reads the selected decode pod's IFR),
+// this decider reads the bottleneck pod's IFR directly — the prefill pool is
+// the serialization point for code-gen requests in a 1P+3D topology.
+//
+// Formula:
+//
+//	nonCachedTokens = len(req.InputTokens) − cachedBlocks × blockSize
+//	prefillIfr      = max(snap.InFlightRequests for snap in state.PrefillSnapshots)
+//	threshold       = lowThreshold  if prefillIfr < ifrGate   (prefill idle)
+//	                = highThreshold if prefillIfr >= ifrGate   (prefill loaded)
+//	Disaggregate    = (nonCachedTokens > threshold)
+//
+// IFR is INV-7-synchronous (cluster.go:1159 overwrites snap.InFlightRequests
+// from the authoritative counter on every dispatch/completion event). The signal
+// is reactive to within-burst load changes regardless of snapshot refresh interval.
+//
+// Factory invariants (R3): ifrGate >= 0; lowThreshold >= 0; highThreshold >= 0;
+// blockSize > 0. No ordering constraint between lowThreshold and highThreshold —
+// the A2 control-negative arm deliberately inverts them.
+//
+// INV-9 oracle boundary: Decide reads only req.InputTokens, cacheQuery, and
+// state.PrefillSnapshots[*].InFlightRequests. Never reads req.OutputTokens.
+type PrefillIfrAdaptivePrefixDecider struct {
+	ifrGate       int
+	lowThreshold  int
+	highThreshold int
+	blockSize     int
+	cacheQuery    map[string]func([]int) int
+}
+
+// NewPrefillIfrAdaptivePrefixDecider creates a PrefillIfrAdaptivePrefixDecider.
+// Invariants (R3 fail-loud): ifrGate >= 0, lowThreshold >= 0, highThreshold >= 0,
+// blockSize > 0. No ordering constraint between lowThreshold and highThreshold
+// (A2 inverts them deliberately).
+//
+// cacheQuery may be nil (e.g. unit tests without cluster state); when nil, or
+// when state.SelectedInstance is missing from the map, Decide returns
+// Disaggregate=false (conservative fallback).
+func NewPrefillIfrAdaptivePrefixDecider(ifrGate, lowThreshold, highThreshold, blockSize int, cacheQuery map[string]func([]int) int) *PrefillIfrAdaptivePrefixDecider {
+	if ifrGate < 0 {
+		panic(fmt.Sprintf("NewPrefillIfrAdaptivePrefixDecider: ifrGate must be >= 0, got %d", ifrGate))
+	}
+	if lowThreshold < 0 {
+		panic(fmt.Sprintf("NewPrefillIfrAdaptivePrefixDecider: lowThreshold must be >= 0, got %d", lowThreshold))
+	}
+	if highThreshold < 0 {
+		panic(fmt.Sprintf("NewPrefillIfrAdaptivePrefixDecider: highThreshold must be >= 0, got %d", highThreshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewPrefillIfrAdaptivePrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	return &PrefillIfrAdaptivePrefixDecider{
+		ifrGate:       ifrGate,
+		lowThreshold:  lowThreshold,
+		highThreshold: highThreshold,
+		blockSize:     blockSize,
+		cacheQuery:    cacheQuery,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens exceeds the threshold
+// selected by the prefill pool's aggregate synchronous InFlightRequests:
+//   - max(prefillIfr) < ifrGate  → lowThreshold (prefill idle, disaggregate freely)
+//   - max(prefillIfr) >= ifrGate → highThreshold (prefill loaded, colocate on decode)
+//
+// Early returns (all yielding Disaggregate=false):
+//   - len(req.InputTokens) == 0
+//   - state == nil
+//   - state.SelectedInstance == "" (no upstream decode selection)
+//   - cacheQuery is nil, or selected instance is missing, or its closure is nil
+//   - len(state.PrefillSnapshots) == 0 (no routable prefill instances)
+func (d *PrefillIfrAdaptivePrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if len(state.PrefillSnapshots) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	// Aggregate prefill-pool IFR: max over all prefill instances.
+	// In 1P+3D topology this equals the only prefill pod's IFR.
+	// max() generalizes to N prefill pods: "did ANY prefill pod cross the gate?"
+	prefillIfr := 0
+	for i := range state.PrefillSnapshots {
+		if state.PrefillSnapshots[i].InFlightRequests > prefillIfr {
+			prefillIfr = state.PrefillSnapshots[i].InFlightRequests
+		}
+	}
+	var threshold int
+	if prefillIfr < d.ifrGate {
+		threshold = d.lowThreshold
+	} else {
+		threshold = d.highThreshold
+	}
+	return DisaggregationDecision{Disaggregate: nonCachedTokens > threshold}
+}
+
+// PrefillQdAdaptivePrefixDecider (iter-7, prefill-qd-adaptive-prefix)
+//
+// PrefillQdAdaptivePrefixDecider disaggregates a request based on a 2-band
+// threshold controlled by the prefill pool's aggregate QueueDepth (QD) signal.
+// It mirrors PrefillIfrAdaptivePrefixDecider exactly, swapping the gate signal
+// from InFlightRequests (synchronous) to QueueDepth (Periodic, 50ms default).
+//
+// Motivation (RP-16): QD is "lazier" than IFR. Once a request queues behind a
+// long code-gen prefill, QD stays elevated for as long as the prefill computes
+// (~hundreds of ms, multiple 50ms snapshot windows), where IFR drops to 0 in
+// any window without an active prefill kernel. QD's persistence property means
+// qdGate=1 fires across the full congestion window for bursty arrivals.
+//
+// INV-7 (signal freshness): QueueDepth is Periodic (refreshed at the
+// snapshot-refresh-interval, default 50ms). Run with default interval to
+// preserve comparability with iter-1/5/6.
+//
+// INV-9 oracle boundary: Decide reads only req.InputTokens, cacheQuery, and
+// state.PrefillSnapshots[*].QueueDepth. Never reads req.OutputTokens.
+type PrefillQdAdaptivePrefixDecider struct {
+	qdGate        int
+	lowThreshold  int
+	highThreshold int
+	blockSize     int
+	cacheQuery    map[string]func([]int) int
+}
+
+// NewPrefillQdAdaptivePrefixDecider creates a PrefillQdAdaptivePrefixDecider.
+// Invariants (R3 fail-loud): qdGate >= 0, lowThreshold >= 0, highThreshold >= 0,
+// blockSize > 0. No ordering constraint between lowThreshold and highThreshold.
+//
+// cacheQuery may be nil (e.g. unit tests without cluster state); when nil, or
+// when state.SelectedInstance is missing from the map, Decide returns
+// Disaggregate=false (conservative fallback).
+func NewPrefillQdAdaptivePrefixDecider(qdGate, lowThreshold, highThreshold, blockSize int, cacheQuery map[string]func([]int) int) *PrefillQdAdaptivePrefixDecider {
+	if qdGate < 0 {
+		panic(fmt.Sprintf("NewPrefillQdAdaptivePrefixDecider: qdGate must be >= 0, got %d", qdGate))
+	}
+	if lowThreshold < 0 {
+		panic(fmt.Sprintf("NewPrefillQdAdaptivePrefixDecider: lowThreshold must be >= 0, got %d", lowThreshold))
+	}
+	if highThreshold < 0 {
+		panic(fmt.Sprintf("NewPrefillQdAdaptivePrefixDecider: highThreshold must be >= 0, got %d", highThreshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewPrefillQdAdaptivePrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	return &PrefillQdAdaptivePrefixDecider{
+		qdGate:        qdGate,
+		lowThreshold:  lowThreshold,
+		highThreshold: highThreshold,
+		blockSize:     blockSize,
+		cacheQuery:    cacheQuery,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens exceeds the threshold
+// selected by the prefill pool's aggregate Periodic QueueDepth:
+//   - max(prefillQd) < qdGate  → lowThreshold (prefill idle, disaggregate freely)
