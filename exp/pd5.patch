+// TestNewIfrAdaptivePrefixDecider verifies factory invariants and Decide band selection.
+func TestNewIfrAdaptivePrefixDecider(t *testing.T) {
+	trivialCache := map[string]func([]int) int{
+		"pod0": func([]int) int { return 0 },
+	}
+	stateWithIFR := func(ifr int) *RouterState {
+		return &RouterState{
+			Snapshots:        []RoutingSnapshot{{ID: "pod0", InFlightRequests: ifr}},
+			SelectedInstance: "pod0",
+		}
+	}
+	req100 := &Request{ID: "r1", InputTokens: make([]int, 100)}
+
+	// Factory panic cases.
+	panicCases := []struct {
+		name string
+		fn   func()
+	}{
+		{"lowWatermark<0", func() { NewIfrAdaptivePrefixDecider(-1, 12, 0, 1024, 4096, 16, trivialCache) }},
+		{"highWatermark<0", func() { NewIfrAdaptivePrefixDecider(4, -1, 0, 1024, 4096, 16, trivialCache) }},
+		{"lowWatermark>=highWatermark equal", func() { NewIfrAdaptivePrefixDecider(12, 12, 0, 1024, 4096, 16, trivialCache) }},
+		{"lowWatermark>highWatermark", func() { NewIfrAdaptivePrefixDecider(13, 12, 0, 1024, 4096, 16, trivialCache) }},
+		{"lowThreshold<0", func() { NewIfrAdaptivePrefixDecider(4, 12, -1, 1024, 4096, 16, trivialCache) }},
+		{"midThreshold<0", func() { NewIfrAdaptivePrefixDecider(4, 12, 0, -1, 4096, 16, trivialCache) }},
+		{"highThreshold<0", func() { NewIfrAdaptivePrefixDecider(4, 12, 0, 1024, -1, 16, trivialCache) }},
+		{"blockSize<=0", func() { NewIfrAdaptivePrefixDecider(4, 12, 0, 1024, 4096, 0, trivialCache) }},
+	}
+	for _, tc := range panicCases {
+		tc := tc
+		t.Run("panic_"+tc.name, func(t *testing.T) {
+			defer func() {
+				if r := recover(); r == nil {
+					t.Errorf("expected panic for %s but did not panic", tc.name)
+				}
+			}()
+			tc.fn()
+		})
+	}
+
+	// Valid construction succeeds.
+	d := NewIfrAdaptivePrefixDecider(4, 12, 0, 1024, 4096, 16, trivialCache)
+
+	// Early-return cases: all return Disaggregate=false.
+	t.Run("empty_input_tokens", func(t *testing.T) {
+		if d.Decide(&Request{}, stateWithIFR(0)).Disaggregate {
+			t.Error("expected false for empty input tokens")
+		}
+	})
+	t.Run("nil_state", func(t *testing.T) {
+		if d.Decide(req100, nil).Disaggregate {
+			t.Error("expected false for nil state")
+		}
+	})
+	t.Run("empty_selected_instance", func(t *testing.T) {
+		state := &RouterState{Snapshots: []RoutingSnapshot{{ID: "pod0"}}, SelectedInstance: ""}
+		if d.Decide(req100, state).Disaggregate {
+			t.Error("expected false for empty SelectedInstance")
+		}
+	})
+	t.Run("nil_cache_query", func(t *testing.T) {
+		dNil := NewIfrAdaptivePrefixDecider(4, 12, 0, 1024, 4096, 16, nil)
+		if dNil.Decide(req100, stateWithIFR(0)).Disaggregate {
+			t.Error("expected false when cacheQuery is nil")
+		}
+	})
+	t.Run("missing_snapshot", func(t *testing.T) {
+		state := &RouterState{Snapshots: []RoutingSnapshot{{ID: "other"}}, SelectedInstance: "pod0"}
+		if d.Decide(req100, state).Disaggregate {
+			t.Error("expected false when no snapshot matches SelectedInstance")
+		}
+	})
+
+	// Band selection tests with 100 input tokens (nonCached=100, blockSize=16).
+	// idle band: ifr<=4 → highThreshold=4096; nonCached(100) <= 4096 → colocate
+	t.Run("idle_band_colocate", func(t *testing.T) {
+		if d.Decide(req100, stateWithIFR(4)).Disaggregate {
+			t.Error("expected colocate (false) in idle band when nonCached<=highThreshold")
+		}
+	})
+	// idle band: ifr<=4, large request with nonCached > highThreshold → disaggregate
+	t.Run("idle_band_disagg_large", func(t *testing.T) {
+		bigReq := &Request{ID: "big", InputTokens: make([]int, 4097)}
+		if !d.Decide(bigReq, stateWithIFR(0)).Disaggregate {
+			t.Error("expected disaggregate (true) in idle band when nonCached>highThreshold")
+		}
+	})
+	// mid band: lowWatermark<ifr<highWatermark → midThreshold=1024; nonCached(100) <= 1024 → colocate
+	t.Run("mid_band_colocate", func(t *testing.T) {
+		if d.Decide(req100, stateWithIFR(8)).Disaggregate {
+			t.Error("expected colocate (false) in mid band when nonCached<=midThreshold")
+		}
+	})
+	// mid band: large request with nonCached > midThreshold=1024 → disaggregate
+	t.Run("mid_band_disagg_large", func(t *testing.T) {
+		bigReq := &Request{ID: "big", InputTokens: make([]int, 1025)}
+		if !d.Decide(bigReq, stateWithIFR(5)).Disaggregate {
+			t.Error("expected disaggregate (true) in mid band when nonCached>midThreshold")
+		}
+	})
+	// loaded band: ifr>=12 → lowThreshold=0; nonCached(100) > 0 → disaggregate
+	t.Run("loaded_band_disagg", func(t *testing.T) {
+		if !d.Decide(req100, stateWithIFR(12)).Disaggregate {
+			t.Error("expected disaggregate (true) in loaded band when lowThreshold=0")
+		}
+	})
+	// loaded band: high IFR also disaggregates
+	t.Run("loaded_band_high_ifr", func(t *testing.T) {
+		if !d.Decide(req100, stateWithIFR(100)).Disaggregate {
+			t.Error("expected disaggregate (true) at very high IFR")
+		}
+	})
+	// watermark boundary: ifr=lowWatermark → idle band (<=); ifr=lowWatermark+1 → mid band
+	t.Run("boundary_low_watermark", func(t *testing.T) {
+		// At ifr=4 (==lowWatermark): use highThreshold=4096; 100 tokens <= 4096 → colocate
+		if d.Decide(req100, stateWithIFR(4)).Disaggregate {
+			t.Error("expected colocate at ifr==lowWatermark")
+		}
+		// At ifr=5 (lowWatermark<5<highWatermark): use midThreshold=1024; 100 <= 1024 → colocate
+		if d.Decide(req100, stateWithIFR(5)).Disaggregate {
+			t.Error("expected colocate at ifr just above lowWatermark (mid band)")
+		}
+	})
+	// watermark boundary: ifr=highWatermark-1 → mid band; ifr=highWatermark → loaded band
+	t.Run("boundary_high_watermark", func(t *testing.T) {
+		// At ifr=11 (<highWatermark=12): mid band; req100 nonCached=100 <= 1024 → colocate
+		if d.Decide(req100, stateWithIFR(11)).Disaggregate {
+			t.Error("expected colocate at ifr just below highWatermark (mid band)")
+		}
+		// At ifr=12 (==highWatermark): loaded band; lowThreshold=0; 100 > 0 → disagg
+		if !d.Decide(req100, stateWithIFR(12)).Disaggregate {
+			t.Error("expected disaggregate at ifr==highWatermark (loaded band)")
+		}
+	})
+	// Inverted thresholds (A2 control-negative): lowThreshold=4096, midThreshold=1024, highThreshold=0.
+	// No ordering constraint — inverted direction is the point of A2.
+	t.Run("inverted_thresholds_A2", func(t *testing.T) {
+		// A2: idle pod (IFR<=4) → highThreshold=0 (always disagg); loaded pod (IFR>=12) → lowThreshold=4096 (colocate).
+		dInv := NewIfrAdaptivePrefixDecider(4, 12, 4096, 1024, 0, 16, trivialCache)
+		// idle band: IFR=0 → highThreshold=0; nonCached=100 > 0 → disaggregate
+		if !dInv.Decide(req100, stateWithIFR(0)).Disaggregate {
+			t.Error("A2 idle band: expected disaggregate when highThreshold=0")
+		}
+		// loaded band: IFR=12 → lowThreshold=4096; nonCached=100 <= 4096 → colocate
+		if dInv.Decide(req100, stateWithIFR(12)).Disaggregate {
+			t.Error("A2 loaded band: expected colocate when lowThreshold=4096")
+		}
+	})
+}
