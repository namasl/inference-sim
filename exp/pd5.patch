+// LoadKvGatedPrefixDecider disaggregates a request when the non-cached prefix
+// exceeds a threshold AND (selected decode pod has QueueDepth >= queueGate OR
+// selected decode pod has KVUtilization >= kvGate). The OR-combinator extends
+// LoadGatedPrefix by also triggering disaggregation when a pod is actively
+// decoding (KV held, QD=0) — exactly the regime where the QD-only gate
+// would colocate a new prefill onto an in-progress decode pod.
+//
+// Formula:
+//
+//	nonCachedTokens = len(req.InputTokens) − cachedBlocks × blockSize
+//	gateFires       = (selected.QueueDepth >= queueGate) || (selected.KVUtilization >= kvGate)
+//	Disaggregate    = (nonCachedTokens > threshold) && gateFires
+//
+// Degenerate cases:
+//   - queueGate=0: QD>=0 always true → gate ≡ OR-true → degenerates to PrefixThreshold
+//   - kvGate>1.0 (e.g. 2.0): KVUtil ∈ [0,1] never fires → gate ≡ QD>=queueGate →
+//     degenerates to LoadGatedPrefix(selected, queueGate)
+//
+// mode must be "selected" (pod chosen by upstream decode routing). pool-sum and
+// max aggregation modes are excluded per RP-16/RP-19.
+type LoadKvGatedPrefixDecider struct {
+	threshold  int
+	blockSize  int
+	queueGate  int
+	kvGate     float64
+	cacheQuery map[string]func([]int) int
+}
+
+// NewLoadKvGatedPrefixDecider creates a LoadKvGatedPrefixDecider.
+// Invariants (R3 fail-loud): threshold >= 0, blockSize > 0, queueGate >= 0,
+// kvGate in [0, 2.0], mode == "selected".
+func NewLoadKvGatedPrefixDecider(threshold, blockSize, queueGate int, kvGate float64, mode string, cacheQuery map[string]func([]int) int) *LoadKvGatedPrefixDecider {
+	if threshold < 0 {
+		panic(fmt.Sprintf("NewLoadKvGatedPrefixDecider: threshold must be >= 0, got %d", threshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewLoadKvGatedPrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	if queueGate < 0 {
+		panic(fmt.Sprintf("NewLoadKvGatedPrefixDecider: queueGate must be >= 0, got %d", queueGate))
+	}
+	if kvGate < 0 {
+		panic(fmt.Sprintf("NewLoadKvGatedPrefixDecider: kvGate must be >= 0, got %f", kvGate))
+	}
+	if kvGate > 2.0 {
+		panic(fmt.Sprintf("NewLoadKvGatedPrefixDecider: kvGate must be <= 2.0, got %f", kvGate))
+	}
+	if mode != "selected" {
+		panic(fmt.Sprintf("NewLoadKvGatedPrefixDecider: mode must be \"selected\", got %q (pool-sum and max aggregation modes are not supported; see RP-16/RP-19)", mode))
+	}
+	return &LoadKvGatedPrefixDecider{
+		threshold:  threshold,
+		blockSize:  blockSize,
+		queueGate:  queueGate,
+		kvGate:     kvGate,
+		cacheQuery: cacheQuery,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens > threshold AND
+// (selected.QueueDepth >= queueGate OR selected.KVUtilization >= kvGate).
+//
+// Early returns (all yielding Disaggregate=false):
+//   - len(req.InputTokens) == 0
+//   - state == nil
+//   - state.SelectedInstance == "" (no upstream selection)
+//   - cacheQuery is nil, or the selected instance is missing from the map,
+//     or its closure is nil
+//   - no snapshot in state.Snapshots matches state.SelectedInstance
+func (d *LoadKvGatedPrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	if nonCachedTokens <= d.threshold {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Find the selected snapshot by ID (read-only linear scan).
+	var selectedSnap *RoutingSnapshot
+	for i := range state.Snapshots {
+		if state.Snapshots[i].ID == state.SelectedInstance {
+			selectedSnap = &state.Snapshots[i]
+			break
+		}
+	}
+	if selectedSnap == nil {
+		// Defensive fallback: no matching snapshot found.
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	gateFires := (selectedSnap.QueueDepth >= d.queueGate) || (selectedSnap.KVUtilization >= d.kvGate)
+	return DisaggregationDecision{Disaggregate: gateFires}
+}
