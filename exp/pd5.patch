+// NewClusterTransientKvGatedPrefixDecider creates a ClusterTransientKvGatedPrefixDecider.
+// Invariants (R3 fail-loud): threshold >= 0, blockSize > 0, queueGate >= 0,
+// kvGate in [0, 2.0], clusterKvGate in [0, 2.0], mode == "selected".
+func NewClusterTransientKvGatedPrefixDecider(threshold, blockSize, queueGate int, kvGate, clusterKvGate float64, mode string, cacheQuery map[string]func([]int) int) *ClusterTransientKvGatedPrefixDecider {
+	if threshold < 0 {
