+// TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_LatchRelease verifies that
+// the latch releases after latchDurationUs microseconds of silence since last fire.
+func TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_LatchRelease(t *testing.T) {
+	trivialCache := map[string]func([]int) int{"decode_0": func([]int) int { return 0 }}
+	// windowSize=1, gateUpBp=1, latchDuration=1s=1_000_000 µs
+	d := NewPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider(1, 1, 1_000_000, 0, 4096, 16, trivialCache)
+	req := &Request{ID: "req", InputTokens: make([]int, 100)} // nonCached=100
+
+	// Fire at clock=0: IFR=1 → latch; lastFireUs=0
+	d.Decide(req, stateWithPrefillIFR(1, 0))
+	if !d.highState {
+		t.Fatal("expected highState=true after fire")
+	}
+
+	// At clock=999_999 (< 1_000_000): still within latch → highState
+	d.Decide(req, stateWithPrefillIFR(0, 999_999))
+	if !d.highState {
+		t.Error("at clock < latchDuration: highState should remain true")
+	}
+
+	// At clock=1_000_000 (== latchDuration since lastFire=0): release
+	d.Decide(req, stateWithPrefillIFR(0, 1_000_000))
+	if d.highState {
+		t.Error("at clock == latchDuration: expected highState=false (released)")
+	}
+}
+
+// TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_LatchRefresh verifies that
+// a re-fire during the hold window refreshes lastFireUs, extending the latch.
+func TestPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider_LatchRefresh(t *testing.T) {
+	trivialCache := map[string]func([]int) int{"decode_0": func([]int) int { return 0 }}
+	// windowSize=1, gateUpBp=1, latchDuration=1s
+	d := NewPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider(1, 1, 1_000_000, 0, 4096, 16, trivialCache)
+	req := &Request{ID: "req", InputTokens: make([]int, 100)}
+
+	// Fire at clock=0
+	d.Decide(req, stateWithPrefillIFR(1, 0))
+	// Re-fire at clock=500_000 (within window) → refreshes lastFireUs to 500_000
+	d.Decide(req, stateWithPrefillIFR(1, 500_000))
+	// At clock=1_200_000 (700_000 since last fire < 1_000_000): still latched
+	d.Decide(req, stateWithPrefillIFR(0, 1_200_000))
+	if !d.highState {
+		t.Error("after refresh: latch should extend; expected highState=true at 700ms after last fire")
+	}
+	// At clock=1_600_000 (1_100_000 since last fire >= 1_000_000): released
+	d.Decide(req, stateWithPrefillIFR(0, 1_600_000))
+	if d.highState {
+		t.Error("after refresh+expiry: expected highState=false at 1100ms after last fire")
+	}
+}
