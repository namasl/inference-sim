+	}
+	if latchDurationUs < 0 {
+		panic(fmt.Sprintf("NewPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider: latchDurationUs must be >= 0, got %d", latchDurationUs))
+	}
+	if lowThreshold < 0 {
+		panic(fmt.Sprintf("NewPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider: lowThreshold must be >= 0, got %d", lowThreshold))
+	}
+	if highThreshold < 0 {
+		panic(fmt.Sprintf("NewPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider: highThreshold must be >= 0, got %d", highThreshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewPrefillIfrDutycycleTimedLatchAdaptivePrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	return &PrefillIfrDutycycleTimedLatchAdaptivePrefixDecider{
+		windowSize:      windowSize,
+		gateUpBp:        gateUpBp,
+		latchDurationUs: latchDurationUs,
+		lowThreshold:    lowThreshold,
+		highThreshold:   highThreshold,
+		blockSize:       blockSize,
+		cacheQuery:      cacheQuery,
+		buffer:          make([]int, windowSize),
+	}
+}
