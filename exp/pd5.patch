+// TestClusterIfrGatedPrefixDecider_SmokeTest verifies constructor invariants (R3/R6),
+// early-return paths, and IFR-clause isolation.
+func TestClusterIfrGatedPrefixDecider_SmokeTest(t *testing.T) {
+	trivialCache := map[string]func([]int) int{
+		"inst-A": func(_ []int) int { return 0 },
+		"inst-B": func(_ []int) int { return 0 },
+		"inst-C": func(_ []int) int { return 0 },
+	}
+
+	// (1) Valid construction — no panic.
+	d := NewClusterIfrGatedPrefixDecider(16, 16, 1, 0.05, 12, "selected", trivialCache)
+	if d == nil {
+		t.Fatal("NewClusterIfrGatedPrefixDecider returned nil")
+	}
+
+	makeState := func(selectedID string, snaps []RoutingSnapshot) *RouterState {
+		return &RouterState{SelectedInstance: selectedID, Snapshots: snaps}
+	}
+	makeReq := func(tokens int) *Request { return &Request{InputTokens: make([]int, tokens)} }
+
+	cases := []struct {
+		name        string
+		req         *Request
+		state       *RouterState
+		wantDisagg  bool
+	}{
+		{
+			name:       "nil state -> false",
+			req:        makeReq(100),
+			state:      nil,
+			wantDisagg: false,
+		},
+		{
+			name:       "empty input tokens -> false",
+			req:        makeReq(0),
+			state:      makeState("inst-A", []RoutingSnapshot{{ID: "inst-A"}}),
+			wantDisagg: false,
+		},
+		{
+			name:       "no selected instance -> false",
+			req:        makeReq(100),
+			state:      makeState("", []RoutingSnapshot{{ID: "inst-A"}}),
+			wantDisagg: false,
+		},
+		{
+			name: "all gates quiet -> false",
+			req:  makeReq(100),
+			state: makeState("inst-A", []RoutingSnapshot{
+				{ID: "inst-A", QueueDepth: 0, KvTokensInUse: 0, TotalKvCapacityTokens: 10000, InFlightRequests: 3},
+				{ID: "inst-B", QueueDepth: 0, KvTokensInUse: 0, TotalKvCapacityTokens: 10000, InFlightRequests: 4},
+				{ID: "inst-C", QueueDepth: 0, KvTokensInUse: 0, TotalKvCapacityTokens: 10000, InFlightRequests: 4},
+			}),
+			wantDisagg: false, // sum IFR = 11 < 12, QD=0, transientKvUtil=0
+		},
+		{
+			name: "IFR clause fires (sum=12) -> true",
+			req:  makeReq(100),
+			state: makeState("inst-A", []RoutingSnapshot{
+				{ID: "inst-A", QueueDepth: 0, KvTokensInUse: 0, TotalKvCapacityTokens: 10000, InFlightRequests: 4},
+				{ID: "inst-B", QueueDepth: 0, KvTokensInUse: 0, TotalKvCapacityTokens: 10000, InFlightRequests: 4},
+				{ID: "inst-C", QueueDepth: 0, KvTokensInUse: 0, TotalKvCapacityTokens: 10000, InFlightRequests: 4},
+			}),
+			wantDisagg: true, // sum IFR = 12 >= 12, QD=0, transientKvUtil=0; only IFR fires
+		},
+		{
+			name: "threshold not exceeded -> false despite high IFR",
+			req:  makeReq(16), // exactly at threshold, not above
+			state: makeState("inst-A", []RoutingSnapshot{
+				{ID: "inst-A", QueueDepth: 0, KvTokensInUse: 0, TotalKvCapacityTokens: 10000, InFlightRequests: 100},
+			}),
+			wantDisagg: false, // nonCachedTokens=16 == threshold=16 (not >)
+		},
+		{
+			name: "selected snapshot missing -> false",
+			req:  makeReq(100),
+			state: makeState("inst-Z", []RoutingSnapshot{
+				{ID: "inst-A", QueueDepth: 0, KvTokensInUse: 0, TotalKvCapacityTokens: 10000, InFlightRequests: 50},
+			}),
+			wantDisagg: false,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := d.Decide(tc.req, tc.state)
+			if got.Disaggregate != tc.wantDisagg {
+				t.Errorf("Decide() = %v, want %v", got.Disaggregate, tc.wantDisagg)
+			}
+		})
+	}
+
+	// (7) mode != "selected" panics.
+	func() {
+		defer func() {
+			if r := recover(); r == nil {
+				t.Error("NewClusterIfrGatedPrefixDecider with mode='max' did not panic")
+			}
+		}()
+		_ = NewClusterIfrGatedPrefixDecider(16, 16, 1, 0.05, 12, "max", trivialCache)
+	}()
+}
