+// CacheBypassedKvGatedPrefixDecider extends CacheAwareKvGatedPrefixDecider with a
+// per-request "cache-magnitude switch": when the request's cached-prefix size on the
+// selected decode pod is >= cacheCapTokens, the transient-KV gate is bypassed entirely
+// and the decision reduces to QD-only (LoadGatedPrefix behavior). When cachedTokens <
+// cacheCapTokens, the full OR-combined (QD ∨ transientKvUtil) gate from
+// CacheAwareKvGatedPrefixDecider is evaluated.
+//
+// Formula:
+//
+//	nonCachedTokens = len(req.InputTokens) − cachedBlocks × blockSize
+//	cachedTokens    = cachedBlocks × blockSize
+//	qdFires         = (selected.QueueDepth >= queueGate)
+//	kvFires         = false
+//	if cachedTokens < cacheCapTokens:
+//	    transientKvTokens = max(0, KvTokensInUse − cachedTokens)
+//	    transientKvUtil   = transientKvTokens / TotalKvCapacityTokens  (0 if capacity ≤ 0)
+//	    kvFires           = (transientKvUtil >= kvGate)
+//	Disaggregate = (nonCachedTokens > threshold) && (qdFires || kvFires)
+//
+// Degenerate cases:
+//   - cacheCapTokens=0: cachedTokens >= 0 always → kvFires always false → degenerates
+//     to LoadGatedPrefix(selected, queueGate) — byte-identical to iter-1 winner.
+//   - cacheCapTokens=large sentinel (e.g. 1<<30): cachedTokens always < cap → kvFires
+//     always evaluated → byte-identical to CacheAwareKvGatedPrefixDecider.
+//
+// mode must be "selected". pool-sum and max modes are excluded per RP-16/RP-19.
+type CacheBypassedKvGatedPrefixDecider struct {
+	threshold      int
+	blockSize      int
+	queueGate      int
+	kvGate         float64
+	cacheCapTokens int
+	cacheQuery     map[string]func([]int) int
+}
+
+// NewCacheBypassedKvGatedPrefixDecider creates a CacheBypassedKvGatedPrefixDecider.
+// Invariants (R3 fail-loud): threshold >= 0, blockSize > 0, queueGate >= 0,
+// kvGate in [0, 2.0], cacheCapTokens >= 0, mode == "selected".
+func NewCacheBypassedKvGatedPrefixDecider(threshold, blockSize, queueGate int, kvGate float64, cacheCapTokens int, mode string, cacheQuery map[string]func([]int) int) *CacheBypassedKvGatedPrefixDecider {
+	if threshold < 0 {
+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: threshold must be >= 0, got %d", threshold))
+	}
+	if blockSize <= 0 {
+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: blockSize must be > 0, got %d", blockSize))
+	}
+	if queueGate < 0 {
+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: queueGate must be >= 0, got %d", queueGate))
+	}
+	if kvGate < 0 {
+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: kvGate must be >= 0, got %f", kvGate))
+	}
+	if kvGate > 2.0 {
+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: kvGate must be <= 2.0, got %f", kvGate))
+	}
+	if cacheCapTokens < 0 {
+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: cacheCapTokens must be >= 0, got %d", cacheCapTokens))
+	}
+	if mode != "selected" {
+		panic(fmt.Sprintf("NewCacheBypassedKvGatedPrefixDecider: mode must be \"selected\", got %q (pool-sum and max aggregation modes are not supported; see RP-16/RP-19)", mode))
+	}
+	return &CacheBypassedKvGatedPrefixDecider{
+		threshold:      threshold,
+		blockSize:      blockSize,
+		queueGate:      queueGate,
+		kvGate:         kvGate,
+		cacheCapTokens: cacheCapTokens,
+		cacheQuery:     cacheQuery,
+	}
+}
+
+// Decide returns Disaggregate=true when nonCachedTokens > threshold AND
+// (qdFires || kvFires), where kvFires is evaluated only when cachedTokens < cacheCapTokens.
+//
+// Early returns (all yielding Disaggregate=false):
+//   - len(req.InputTokens) == 0
+//   - state == nil
+//   - state.SelectedInstance == "" (no upstream selection)
+//   - cacheQuery is nil, or the selected instance is missing from the map,
+//     or its closure is nil
+//   - no snapshot in state.Snapshots matches state.SelectedInstance
+func (d *CacheBypassedKvGatedPrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	if nonCachedTokens <= d.threshold {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Find the selected snapshot by ID (read-only linear scan).
+	var selectedSnap *RoutingSnapshot
+	for i := range state.Snapshots {
+		if state.Snapshots[i].ID == state.SelectedInstance {
+			selectedSnap = &state.Snapshots[i]
+			break
+		}
+	}
+	if selectedSnap == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedTokens := int64(cachedBlocks * d.blockSize)
+	qdFires := selectedSnap.QueueDepth >= d.queueGate
+	kvFires := false
+	if cachedTokens < int64(d.cacheCapTokens) {
+		transientKvTokens := selectedSnap.KvTokensInUse - cachedTokens
+		if transientKvTokens < 0 {
+			transientKvTokens = 0
+		}
+		var transientKvUtil float64
+		if selectedSnap.TotalKvCapacityTokens > 0 {
+			transientKvUtil = float64(transientKvTokens) / float64(selectedSnap.TotalKvCapacityTokens)
+		}
+		kvFires = transientKvUtil >= d.kvGate
+	}
+	return DisaggregationDecision{Disaggregate: qdFires || kvFires}
+}
