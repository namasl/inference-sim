+// Decide returns Disaggregate=true when nonCachedTokens > threshold AND
+// (selected.QueueDepth >= queueGate OR selected.transientKvUtil >= kvGate
+// OR clusterTransientKvUtil >= clusterKvGate).
+//
+// clusterTransientKvUtil subtracts each pod's per-request cache-hit contribution
+// from its KvTokensInUse before summing, producing a cache-aware cluster signal.
+//
+// Early returns (all yielding Disaggregate=false):
+//   - len(req.InputTokens) == 0
+//   - state == nil
+//   - state.SelectedInstance == "" (no upstream selection)
+//   - cacheQuery is nil, or the selected instance is missing from the map,
+//     or its closure is nil
+//   - no snapshot in state.Snapshots matches state.SelectedInstance
+func (d *ClusterTransientKvGatedPrefixDecider) Decide(req *Request, state *RouterState) DisaggregationDecision {
+	if len(req.InputTokens) == 0 {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	if state == nil || state.SelectedInstance == "" || d.cacheQuery == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	fn, ok := d.cacheQuery[state.SelectedInstance]
+	if !ok || fn == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	cachedBlocks := fn(req.InputTokens)
+	nonCachedTokens := len(req.InputTokens) - cachedBlocks*d.blockSize
+	if nonCachedTokens <= d.threshold {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Find the selected snapshot and compute cache-subtracted cluster-aggregate transient KV.
+	var selectedSnap *RoutingSnapshot
+	var clusterTransientKvTokens, clusterKvCap int64
+	for i := range state.Snapshots {
+		snap := &state.Snapshots[i]
+		// Query each pod's cache for this request's tokens (RP-13: load discount, not warmth proxy).
+		var podCachedTokens int64
+		if podFn, exists := d.cacheQuery[snap.ID]; exists && podFn != nil {
+			podCachedBlocks := podFn(req.InputTokens)
+			podCachedTokens = int64(podCachedBlocks * d.blockSize)
+		}
+		podTransient := snap.KvTokensInUse - podCachedTokens
+		if podTransient < 0 {
+			podTransient = 0
+		}
+		clusterTransientKvTokens += podTransient
+		clusterKvCap += snap.TotalKvCapacityTokens
+		if snap.ID == state.SelectedInstance {
+			selectedSnap = snap
+		}
+	}
+	if selectedSnap == nil {
+		return DisaggregationDecision{Disaggregate: false}
+	}
+	// Per-pod cache-subtracted transient KV for selected pod (same as CacheAwareKvGatedPrefixDecider).
+	cachedTokens := int64(cachedBlocks * d.blockSize)
+	transientKvTokens := selectedSnap.KvTokensInUse - cachedTokens
+	if transientKvTokens < 0 {
+		transientKvTokens = 0
+	}
+	var transientKvUtil float64
+	if selectedSnap.TotalKvCapacityTokens > 0 {
+		transientKvUtil = float64(transientKvTokens) / float64(selectedSnap.TotalKvCapacityTokens)
+	}
+	// Cluster-aggregate transient KV utilization (cache-subtracted across all pods).
+	var clusterTransientKvUtil float64
+	if clusterKvCap > 0 {
+		clusterTransientKvUtil = float64(clusterTransientKvTokens) / float64(clusterKvCap)
+	}
+	gateFires := (selectedSnap.QueueDepth >= d.queueGate) ||
+		(transientKvUtil >= d.kvGate) ||
+		(clusterTransientKvUtil >= d.clusterKvGate)
+	return DisaggregationDecision{Disaggregate: gateFires}
+}
